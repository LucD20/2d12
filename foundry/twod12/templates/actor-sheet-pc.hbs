{{!-- PACK SHEET (v0.0.289): the character sheet and (v0.0.291) the NPC sheet; v0.0.441 (pack SHEETS-HUD): the small sheets. --}}
{{!-- v0.0.441 (pack SHEETS-HUD): an Action's bar. Each cost stamp is the Use button (struck and dashed when it can't be paid: a click still uses
      it, with a warning); two fitting weapons in hand keep a small button each after the stamps; then the name, "Distance · Vs.", the Frequency. --}}
{{#*inline "stamps"}}
{{#if unloaded}}<button type="button" class="ps2-st" data-action="reloadFor" data-tooltip="Unloaded: Reload first (1 AP)" aria-label="{{name}}: unloaded, Reload (1 AP)">Reload</button>
{{else}}{{#each bar.stamps}}<button type="button" class="ps2-st{{#if (or ../off off)}} no{{/if}}" data-action="useStamp"{{#if ../bar.weaponId}} data-weapon-id="{{../bar.weaponId}}"{{/if}}{{#if (gt ../aps.length 1)}} data-ap="{{ap}}"{{/if}}{{#if ../grant.effectId}} data-grant-effect="{{../grant.effectId}}" data-grant-index="{{../grant.index}}"{{/if}}{{#if (or ../off off)}} data-off="{{#if ../off}}{{../offWhy}}{{else}}{{why}}{{/if}}" data-tooltip="{{#if ../off}}{{../offWhy}}{{else}}{{why}}{{/if}} (click to use it anyway)"{{/if}} aria-label="Use {{../name}}, {{label}}">{{label}}</button>{{/each}}
{{!-- v0.0.444 (group 2): no hand buttons: with two fitting weapons the roll dialog has a Roll for each --}}{{/if}}
{{/inline}}
{{#*inline "srow"}}
<div class="ar ps2-oa{{#if off}} off{{/if}}{{#if open}} open{{/if}}{{#if basicAtk}} basicatk{{/if}}" data-item-id="{{id}}">
  <div class="ps2-bar" data-action="toggleCard">
    <span class="ps2-sts">{{> stamps}}</span>
    <a class="ps-nm" role="button" tabindex="0" aria-expanded="{{#if open}}true{{else}}false{{/if}}">{{name}}</a>{{{auto}}}{{#if fav}}<i class="fa-solid fa-star ps-fav" aria-label="Favorite"></i>{{/if}}{{#if sub}}<span class="ps2-sub">{{sub}}</span>{{/if}}
    <span class="ps2-dv">{{bar.dist}}{{#if bar.dist}}{{#if bar.vs}} &middot; {{/if}}{{/if}}{{#if bar.vs}}<b>{{bar.vs}}</b>{{/if}}</span>
    {{#if showFq}}<span class="ps2-fq">{{bar.fqWord}}</span>{{/if}}
  </div>
  <div class="ar-card"></div>
</div>
{{/inline}}
{{#*inline "sect"}}
<div class="ps-block ps2-sec {{cls}}">
  <div class="ps2-band"><i class="ps2-sq fq-{{key}}"></i><b>{{title}}</b>{{#if sub}}<span class="ps2-bsub">{{sub}}</span>{{/if}}</div>
  <div class="atable" data-list="{{list}}">{{#each rows}}{{> srow}}{{/each}}</div>
</div>
{{/inline}}
{{#*inline "senses"}}<span class="ps-senses">{{#each pc.strip.senses}}<span class="ps-sense">{{label}}</span>{{/each}}</span>{{/inline}}
{{#*inline "brow"}}
<div class="ar ps-brw{{#if open}} open{{/if}}" data-item-id="{{id}}">
<div class="ps-brow" {{#if id}}data-action="toggleCard"{{/if}}>
  <span class="ps-slot">{{slot}}</span>
  <span class="ps-bname">{{#if id}}<i class="fa-solid fa-grip-vertical grip" aria-hidden="true"></i>{{/if}}<b class="ps-nm" {{#if id}}role="button" tabindex="0"{{/if}}>{{name}}</b>{{#if id}}<span class="ps-bctl"><a data-action="openItem" aria-label="Edit {{name}}"><i class="fa-solid fa-pen-to-square"></i></a><a data-action="confirmDelete" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</span>
  <span>{{#if cost}}<span class="ps-pill ps2-ink">{{cost}}</span>{{/if}}</span>
  <span class="ps-bfreq">{{freq}}</span>
</div>
<div class="ar-card"></div>
</div>
{{/inline}}
{{!-- v0.0.441 (pack SHEETS-HUD; Lucas, 2026-11-18: the approved sheets, foundry/mockups/sheets "Option 1"): the small sheet. A name plate (the NPC's in
      its rank's color), the stats as ruled lines (the side panel is gone), the Attribute and Modifier tiles, one combat line (Escalation, the Hands
      one above the other, AP), the tabs; each Action one bar whose cost stamp is its Use button, the short card under it. --}}
<div class="twod12 sheet pcs ps2{{#if pc.npc}} npcs{{#if pc.strip.elite}} elite{{/if}}{{/if}}{{#if pc.down.down}} isdown{{/if}}">
  <header class="ps2-plate rk-{{#if pc.npc}}{{pc.head.roleKey}}{{else}}pc{{/if}}">
    <img class="ps2-port" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="Portrait of {{actor.name}}" aria-label="Change the portrait">
    <div class="ps2-id">
      <input class="ps-nameinput ps2-name" type="text" name="name" value="{{actor.name}}" placeholder="Name" aria-label="Name">
      <div class="ps2-l1"><span>Level {{system.level}}</span> &middot; <span>Stage {{system.stage}}</span>
        {{#if pc.npc}} &middot; <span>{{pc.head.size}}</span> &middot; <span>CV {{pc.head.cv}}</span>
        {{else}} &middot; {{#if pc.head.species}}<a data-action="openItem" data-item-id="{{pc.head.species.id}}">{{pc.head.species.name}}</a>{{else}}<em>No species</em>{{/if}}
        {{#if pc.head.cls}}<a data-action="openItem" data-item-id="{{pc.head.cls.id}}">{{pc.head.cls.name}}</a>{{else}}<em>No class</em>{{/if}} &middot; <span>{{pc.head.size}}</span>{{/if}}
        {{#if pc.head.senseWords}} &middot; <span>{{pc.head.senseWords}}</span>{{/if}}</div>
    </div>
    <div class="ps2-who">{{#if pc.npc}}<b>{{pc.head.role}}</b>{{/if}}{{#if (eq pc.head.combat.mode "status")}}<span>{{pc.head.round}}</span>{{/if}}</div>
    <span class="ps2-tools">
      {{#if pc.npc}}{{#if pc.head.isGM}}<a data-action="postStatBlock" role="button" aria-label="Post stat block"><i class="fa-solid fa-scroll"></i></a>{{/if}}{{/if}}
      {{#if (eq pc.head.combat.mode "roll")}}<a data-action="rollInitiative" role="button" aria-label="Roll Initiative"><i class="fa-solid fa-dice-d20"></i></a>{{/if}}
      <a data-action="editSenses" role="button" aria-label="Senses"><i class="fa-solid fa-eye"></i></a>
    </span>
  </header>

  {{!-- the stat lines: Health, the two pools (still the damage taken: Lethal solid, Nonlethal hatched; a click adds damage), the Defenses and movement,
        Immune / Resist / Weak, Rally and the Wounds' counts --}}
  <div class="ps2-stats np">
    {{#with pc.health}}
    <div class="ps2-l split"><span><span class="k">Health</span> <b class="big">{{pool}}</b> <span class="ps2-q">&middot;</span> {{#if down.down}}<b class="big">{{damage}}</b> / {{pool}} damage{{else}}<b class="big">{{toDown}}</b> to Down{{/if}}
      <a class="ps2-guard np-guardbtn{{#unless @root.pc.strip.guard.total}} zero{{/unless}}" role="button" aria-label="Guard: click +1, right-click −1"><span class="k">{{{@root.pc.guardSym}}}Guard</span> <b>{{@root.pc.strip.guard.total}}</b></a></span>
      {{#unless ../pc.npc}}<span class="ps2-q">Dominant Damage: <b class="dom-{{dominant}}">{{dominant}}</b>{{#if down.down}} &rarr; {{down.title}}{{/if}}</span>{{/unless}}</div>
    {{#if down.down}}
    <div class="ps-downbox">
      <div class="ps-dt"><b>DOWN &middot; {{down.title}}</b>{{#if down.tableRolled}}<span>{{down.tableRolled}}</span>{{/if}}</div>
      <span class="ps-dn">{{down.note}}</span>
      {{#if down.kind}}
      <div class="ps-dbtns">
        <button type="button" class="ps-dkeep" data-action="downChoice" data-choice="fight" {{#if down.keepOff}}aria-disabled="true" data-tooltip="{{down.keepOff}}"{{/if}}>Keep fighting</button>
        <button type="button" class="ps-dline" data-action="downChoice" data-choice="collapse" {{#if down.collapseOff}}aria-disabled="true" data-tooltip="{{down.collapseOff}}"{{/if}}>{{down.collapseWord}}</button>
        <button type="button" class="ps-dline" data-action="downCheck">End-of-turn {{down.check}} Check</button>
      </div>
      {{/if}}
    </div>
    {{/if}}
    <div class="ps2-l two">{{#each bars}}<span class="ps2-gauge np-gauge {{#if (eq pool "body")}}v{{else}}r{{/if}}" data-pool="{{pool}}"><span class="k">{{name}}</span> <a class="hpnum" data-action="hpEdit" data-pool="{{pool}}" role="button"><b>{{value}}</b> / {{max}}</a>{{#if tag}} <span class="ps2-tag">{{tag}}</span>{{/if}}<span class="ps2-track" data-tooltip="{{tip}}"><i class="l" style="width:{{seg.lethal}}%"></i><i class="n" style="width:{{seg.nonlethal}}%"></i></span></span>{{/each}}</div>
    {{/with}}
    <div class="ps2-l grid">{{#each pc.defs.main}}<span><span class="k">{{{sym}}}{{label}}</span> <b class="big {{cls}}">{{value}}</b></span>{{/each}}{{#each pc.move}}<span><span class="k">{{{sym}}}{{label}}</span> <b class="big {{cls}}">{{value}}</b></span>{{/each}}</div>
    {{{pc.dmgHtml}}}
    {{#unless pc.npc}}<div class="ps2-l split"><span><span class="k">Rally</span> <span class="ps2-rpips">{{#each pc.rally.pips}}<i class="{{#if this}}on{{/if}}" data-action="setRally" data-n="{{@index}}" role="button" aria-label="Rally Point {{@index}}"></i>{{/each}}</span> <b>{{pc.rally.left}}</b> / {{pc.rally.max}} <span class="ps2-q">&middot; each heals {{pc.rally.heal}}</span></span>
      <span><span class="k">Wounds</span>{{#each pc.wounds}} {{check}} <input class="ps2-in" type="number" min="0" name="system.{{key}}Wounds" value="{{count}}" aria-label="{{label}}">{{/each}}</span></div>{{/unless}}
  </div>

  {{!-- the Attributes (a click rolls the Check; the Vs. Defense under it) and the Modifiers with their Save DC --}}
  <div class="ps2-tiles m{{pc.mods.length}}">
    {{#each pc.attrs}}<button type="button" class="ps2-tile" data-action="rollAttr" data-key="{{key}}"><span>{{label}}</span><b>{{value}}</b><small>Vs. {{vs}}</small></button>{{/each}}
    {{#each pc.mods}}<div class="ps2-tile mod{{#if @first}} gap{{/if}}"><span>{{tile}}</span><b>{{value}}</b><small>{{dc}}</small></div>{{/each}}
  </div>
  {{#if pc.modConflict}}<div class="ps2-note">{{pc.modConflict}}</div>{{/if}}

  {{!-- v0.0.443 (group 1; Lucas, 2026-11-19, foundry/mockups/group1 rounds 1 to 3): the combat line. A PC and an Elite: the hooks and the Escalation
        ladder (each rung's shield, its number, its name) side by side, then the marks: AP (the HUD's squares, the Reaction AP's gold diamond, the
        Strikes' slashes) and Esc. (the HUD's ticks, a rung's taller). A Standard NPC: its marks at the right. The Hands left the line (the HUD and
        the Inventory hold them). The line never grows (fixed height; actor-sheets.mjs _fitLists shrinks the lists). --}}
  {{#*inline "lists"}}<div class="ps2-cell ps2-lists{{#if idle}} idle{{/if}}"><div class="ps2-col"><span class="ps2-hk">Hooks</span>{{#if pc.strip.lists.hooks.length}}<span class="ps2-ls ps2-hks">{{#each pc.strip.lists.hooks}}<b class="{{#if used}}used{{/if}}" data-action="showInfo" data-info="{{info}}" role="button" tabindex="0">{{name}}{{#if used}}<i>&#10003;</i>{{/if}}</b>{{/each}}</span>{{else}}<span class="ps2-ls ps2-none">None</span>{{/if}}</div><div class="ps2-col"><span class="ps2-hk">Escalation</span><span class="ps2-ls ps2-ld">{{#each pc.strip.lists.ladder}}<span class="{{#if lit}}lit{{/if}}" data-action="showInfo" data-info="{{info}}" role="button" tabindex="0">{{{sym}}}<b>{{n}}</b>{{name}}</span>{{/each}}</span></div></div>{{/inline}}
  {{#if pc.strip.inCombat}}
  <div class="ps2-combat{{#unless pc.strip.lists}} std{{/unless}}">
    {{#if pc.strip.lists}}{{> lists pc=pc}}{{else}}<div class="ps2-cell"></div>{{/if}}
    <div class="ps2-cell ps2-ap ps2-marks">
      <span class="k">AP</span>
      <span class="ps2-mrow"><span class="ps2-pips" aria-label="{{pc.strip.ap.tip}}">{{#each pc.strip.ap.pips}}{{#if (eq k "slowed")}}<span class="pip slowed" aria-label="{{../pc.strip.ap.slowedTip}}">&times;</span>{{else}}<a class="pip {{k}}" data-action="setApPip" data-n="{{n}}" role="button" aria-label="AP {{n}}"></a>{{/if}}{{/each}}<span class="pip-sep"></span><a class="pip rap{{#if pc.strip.ap.rap}} on{{/if}}" data-action="toggleRap" role="button" aria-label="Reaction AP"></a></span><span class="ps2-sep"></span><span class="ps2-strk" aria-label="Strikes left this turn: {{pc.strip.strikesLeft}} of 3">{{#each pc.strip.strikePips}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span></span>
      {{#if pc.strip.lists}}<span class="k">Esc.</span>
      <span class="ps2-mrow"><span class="ps2-ticks">{{#each pc.strip.esc.marks}}<a class="{{#if on}}on{{/if}}{{#if rung}} rg{{/if}}" data-action="setEscalation" data-n="{{n}}" role="button" aria-label="Escalation {{n}}"></a>{{/each}}</span><b class="ps2-en">{{pc.strip.esc.n}}</b>{{#if pc.strip.esc.momentum}} <span class="ps2-q">Momentum {{pc.strip.esc.momentum}}</span>{{/if}}</span>{{/if}}
      {{#if pc.strip.nextBane}}<span class="ps2-q bane">{{pc.strip.nextBane}}</span>{{/if}}
    </div>
  </div>
  {{else}}
  <div class="ps2-combat out{{#unless pc.strip.lists}} std{{/unless}}">
    {{#if pc.strip.lists}}{{> lists pc=pc idle=true}}{{else}}<div class="ps2-cell"></div>{{/if}}
    <div class="ps2-cell ps2-outw"><span>Out of combat</span></div>
  </div>
  {{/if}}

  <div class="ps-body">
    <section class="ps-main mn">
      <nav class="ps-tabs" aria-label="Sheet tabs">
        <a class="tabbtn" data-action="switchTab" data-tab-target="favorites" aria-label="Favorites" role="tab" tabindex="0"><i class="fa-regular fa-star"></i></a>
        {{#each pc.tabs}}<a class="tabbtn" data-action="switchTab" data-tab-target="{{k}}" role="tab" tabindex="0">{{l}}{{#if n}} <span class="tabcount">{{n}}</span>{{/if}}</a>{{/each}}
      </nav>
      <div class="ps-scroll">

      <div class="tab" data-tab="favorites">
        {{#if pc.favRows.length}}
        <div class="ps-block"><div class="atable" data-list="favorites">{{#each pc.favRows}}{{> srow}}{{/each}}</div></div>
        {{else}}<div class="ps-empty"><i class="fa-regular fa-star"></i> Right-click an Action on the Actions tab and choose Favorite to keep it here. Drag the rows to put them in your order.</div>{{/if}}
      </div>

      <div class="tab" data-tab="actions">
        {{#if pc.npc}}<div class="ps2-links"><a data-action="generateAction" role="button"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate Action</a><a data-action="browseCompendium" role="button"><i class="fa-solid fa-book-open"></i> Browse compendium</a><a data-action="newAction" role="button"><i class="fa-solid fa-plus"></i> New Action</a></div>{{/if}}
        <div class="ps-stack">
          {{#each pc.sections}}{{> sect list="actions"}}{{else}}<div class="ps-empty">No Actions yet. Drag Actions, Features, Talents or Weapons onto this sheet.</div>{{/each}}
        </div>
        {{!-- v0.0.441: the Basic Actions' four columns kept, each Action one line (its Frequency's muted strip, a Strike's second strip; its cost; its
              reason when it can't be used); the legend is gone --}}
        <div class="ps-basic ps2-basic">
          <div class="ps2-band"><b>Basic Actions</b><a class="ps-upd" data-action="addBasic">{{#if missingBasic}}Add{{else}}Update{{/if}} Basic Actions</a></div>
          <div class="ps2-bgrid">
            {{#each pc.basic}}
            <div class="ps2-bcol"><span class="ps2-bgh">{{label}}</span>
              {{#each rows}}
              <div class="ar ps-bx ps2-bx{{#if off}} off{{/if}}{{#if open}} open{{/if}}" data-item-id="{{id}}">
                <button type="button" class="ps2-bxbtn{{#if lines.strike}} strike{{/if}}" style="--lnf:{{#if off}}var(--s-faint){{else}}var(--s-fq-{{fq}}){{/if}}" {{#if off}}data-action="useAction" data-off="{{offWhy}}" data-tooltip="{{offWhy}} (click to use it anyway)"{{else}}{{#if weaponId}}data-action="useWith" data-weapon-id="{{weaponId}}"{{else}}data-action="useAction"{{/if}}{{/if}} aria-label="{{name}}{{#if off}}: {{offWhy}}{{/if}}">
                  <span class="ps2-bxl"><span class="ps2-bxn" data-fit="1">{{name}}</span>{{#if next}}<small>{{next}}</small>{{/if}}{{#if off}}<small>{{offWhy}}</small>{{/if}}</span>
                  {{#unless off}}<b>{{cost}}</b>{{/unless}}
                </button>
                <div class="ar-card"></div>
              </div>
              {{/each}}
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      <div class="tab" data-tab="effects">
        <div class="ps-stack">
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#a8322d"></span><b>Conditions</b></div>
            {{#each pc.effects.conditions}}
            <div class="ps-erow" {{#if id}}data-effect-id="{{id}}"{{/if}}{{#if counter}} data-counter="1"{{/if}}>
              <span class="ps-eic {{tone}}">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initial}}{{/if}}</span>
              <b>{{#if id}}<a data-action="openEffect">{{name}}</a>{{else}}{{name}}{{/if}}</b>
              <span class="ps-etext">{{{text}}}</span>
              <span class="ps-epill">{{pill}}</span>
              <span class="ps-ectl">{{#if counter}}<a data-action="exhaustedDown" aria-label="Exhausted −1">&minus;</a><a data-action="exhaustedUp" aria-label="Exhausted +1">+</a>{{/if}}{{#if id}}<a data-action="deleteEffect" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>
            </div>
            {{else}}<div class="ps-erow none">No conditions.</div>{{/each}}
          </div>
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#1b2433"></span><b>Effects</b></div>
            {{#each pc.effects.effects}}
            <div class="ps-erow{{#if off}} offfx{{/if}}" data-effect-id="{{id}}">
              <span class="ps-eic good">{{#if img}}<img src="{{img}}" alt="">{{else}}+{{/if}}</span>
              <b><a data-action="openEffect">{{name}}</a></b>
              <span class="ps-etext">{{{text}}}{{#if source}} <span class="ps-mut">{{source}}.</span>{{/if}}</span>
              <span class="ps-epill">{{pill}}</span>
              <span class="ps-ectl"><a data-action="deleteEffect" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></a></span>
            </div>
            {{else}}<div class="ps-erow none">No effects on you.</div>{{/each}}
          </div>
          <div class="ps-drop edrop">Drop an effect or a condition here to apply it</div>
        </div>
      </div>

      {{!-- v0.0.455 (Lucas, group 4: "Where A, links A"): the Inventory (was Items): Weapons, Armor and Gear as ruled lines (inventory.mjs) --}}
      <div class="tab" data-tab="items">
        <div class="ps-stack">{{{pc.inventoryHtml}}}</div>
      </div>

      <div class="tab" data-tab="build">
        <div class="ps-stack">
          {{#if pc.build.banner}}<div class="ps-banner"><b>{{pc.build.banner.count}} card{{#unless pc.build.banner.one}}s{{/unless}} fill no slot:</b><span>{{pc.build.banner.names}}</span><button type="button" data-action="reviewSlots">Review</button></div>{{/if}}
          {{!-- v0.0.455 (Lucas, group 3: "Stage A, Level B, Species and Class A"): the Stage as the tab's title band (its levels, when the next Stage
                comes, the Level and Change level at the right, the 15 levels' ladder under); the Level changes only through Change level's window --}}
          {{#with pc.build.stageBand}}
          <div class="bt-stage"><div class="bt-st1"><div class="bt-stt"><span class="bt-stw">Stage</span> <span class="bt-stn">{{n}}</span></div>
            <div class="bt-sts"><span>{{levels}}</span><span class="bt-q">{{next}}</span></div>
            <span class="bt-lvc"><span class="bt-lvw">Level <b>{{lv}}</b></span><button type="button" class="bt-btn" data-action="changeLevel">Change level</button></span></div>
            <div class="bt-ladder" role="img" aria-label="Level {{lv}} of 15">{{#each ladder}}<div class="bt-lg{{#if on}} on{{/if}}{{#if first}} first{{/if}}"><span class="bt-cells">{{#each cells}}<i class="{{cls}}">{{n}}</i>{{/each}}</span><small>{{label}}</small></div>{{/each}}</div>
          </div>
          {{/with}}
          {{!-- Species and Class: two ruled entries (the kind at the left, the name, Choices at the right; two lines of what it gives) --}}
          <div class="bt-origin">
            {{#each pc.build.origin}}
            <div class="bt-ent"><div class="bt-eh"><span class="bt-ek">{{kind}}</span><b class="bt-en">{{name}}</b><span class="bt-ebtns">{{#if swap}}<button type="button" class="bt-btn quiet" data-action="swapRest" aria-label="{{swap.tip}}"><i class="fa-solid fa-right-left"></i> Swap on a Rest</button>{{/if}}<button type="button" class="bt-btn quiet" data-action="{{action}}">Choices</button></span></div>
              {{#each lines}}<div class="bt-el">{{#each this}}<span class="bt-kv"><span class="bt-k">{{k}}</span> <b class="{{cls}}">{{v}}</b></span>{{/each}}</div>{{/each}}
            </div>
            {{else}}<div class="ps-empty">Drop a Species and a Class on this sheet.</div>{{/each}}
          </div>
          {{#each pc.build.levels}}
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#6b665a"></span><b>{{title}}</b></div>
            <div class="flist olist ps-blist" data-order-flag="featureOrder">{{#each rows}}{{> brow}}{{/each}}</div>
          </div>
          {{/each}}
          {{#if pc.build.esc.length}}
          <div class="ps-block esc"><div class="ps-bh"><span class="ps-dot" style="background:#c9821f"></span><b>Escalation</b></div>
            {{#each pc.build.esc}}{{> brow}}{{/each}}
          </div>
          {{/if}}
          {{#if pc.build.other.length}}
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#6b665a"></span><b>Other</b><span class="ps-bsub">given by hand (not from your class table)</span></div>
            {{#each pc.build.other}}{{> brow}}{{/each}}
          </div>
          {{/if}}
          {{#if pc.build.next.length}}
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#6b665a"></span><b>Next levels</b></div>
            <div class="ps-next">{{#each pc.build.next}}<span>Level {{level}}</span><span>{{text}}</span>{{/each}}</div>
          </div>
          {{/if}}
          <div class="flist" data-list="talents">
            {{#each pc.build.emptySlots}}<div class="tfslot talentslot" data-slot="{{key}}"><i class="fa-solid fa-plus"></i> Drop a Talent here <span class="tfslotsrc">from {{feature}}</span></div>{{/each}}
            <div class="tfslot talentslot extra" data-slot=""><i class="fa-solid fa-plus"></i> Drop an extra Talent here (the GM's)</div>
          </div>
        </div>
      </div>

      <div class="tab" data-tab="mastery">
        <div class="ps-stack">
          <div class="ps-ih"><span class="ps-h2">Weapon Mastery</span><span class="ps-mut">A Tier 3 with a weapon in an encounter: +1 Mastery with its kind</span></div>
          {{#each startMastery}}<div class="ps-note"><i class="fa-solid fa-bullseye"></i> <b>{{from}}:</b> {{#if chosen}}{{chosen}} ({{value}} Mastery from the start){{else}}<a data-action="chooseStartMastery" data-item="{{itemId}}">choose your {{traitName}} weapon</a> to start with {{value}} Mastery with it{{/if}}</div>{{/each}}
          {{#each pc.mastery}}
          <div class="ps-block"><div class="ps-bh"><b>{{name}}</b><span class="ps-bsub">{{note}}</span>{{#if @root.isGMUser}}<span class="ps-gmstep"><a data-action="masteryStep" data-key="{{key}}" data-d="-1" aria-label="1 less"><i class="fa-solid fa-minus"></i></a><a data-action="masteryStep" data-key="{{key}}" data-d="1" aria-label="1 more"><i class="fa-solid fa-plus"></i></a></span>{{/if}}</div>
            {{#each rows}}
            <div class="ps-mrow{{#if muted}} muted{{/if}}"><b>{{name}}</b>
              <div class="ps-mbar"><div class="ps-mtrack"><span style="width:{{pct}}%"></span>{{#each marks}}<i style="left:{{at}}%"></i>{{/each}}</div><div class="ps-mlab">{{#each marks}}<span style="left:{{at}}%">{{l}}</span>{{/each}}</div></div>
              <span class="ps-mnum">{{value}} / {{next}}</span>
            </div>
            {{/each}}
          </div>
          {{else}}<div class="ps-empty">No Mastery yet: add a weapon to this character and it shows here.</div>{{/each}}
          <div class="ps-mut">Technique (3): the weapon's Weapon Technique, used only with that weapon while you wield it. Expert (8): once each turn, draw, stow or change the grip of the weapon without Interact. Master (15): from level 8, one more [W] with the weapon.</div>
        </div>
      </div>

      <div class="tab" data-tab="upkeep">
        <div class="ps-stack">
          <div class="ps-ih"><span class="ps-h2">Recovery</span><span class="ps-mut">each button asks to confirm and posts a chat line</span><span class="ps-right">Exhausted <b>{{pc.upkeep.exhausted}}</b> &middot; last Sleep <b>{{pc.upkeep.lastSleep}}</b></span></div>
          <div class="ps-g3">
            {{#each pc.upkeep.cards}}
            <div class="ps-rcard" style="--rc:{{color}}">
              <div class="ps-rch"><b>{{name}}</b><span>{{time}}</span></div>
              <span>{{text}}</span>
              {{#if now}}<span class="ps-mut {{nowCls}}">{{now}}</span>{{/if}}
              <button type="button" data-action="recover" data-k="{{k}}" {{#if off}}aria-disabled="true" class="dis" data-tooltip="{{off}}"{{/if}}>{{button}}</button>
            </div>
            {{/each}}
          </div>
          <span class="ps-h2">Upkeep</span>
          <div class="ps-placeholder"><b>[Upkeep mechanics: placeholder]</b><span>Space reserved for the coming Upkeep rules.</span></div>
          <span class="ps-h2">Wounds</span>
          <div class="ps-g2 wide">
            {{#each pc.wounds}}
            <div class="ps-uw {{key}}"><div class="ps-uwh"><b>{{label}} {{count}}</b><span class="ps-mut">Rest: {{check}} Check</span></div>
              {{#each named}}<button type="button" class="ps-uwchip" data-effect-id="{{id}}" data-action="openEffect">{{name}}</button>{{else}}<span class="ps-mut">none named</span>{{/each}}
              {{!-- v0.0.441: the Roll Dying / Roll Shattered buttons moved here from the side panel --}}
              <button type="button" class="ps-wroll" data-action="rollTable" data-kind="{{table}}">Roll {{tableName}}</button>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      {{#if pc.npc}}
      <div class="tab" data-tab="builder">
        {{#with pc.builder}}
        <div class="ps-stack nbld">
          <div class="nb-top">
            <div class="ps-roleseg" role="group" aria-label="Rank">{{#each roles}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setRole" data-role="{{key}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div>
            {{!-- v0.0.407 (the Bestiary, Roles): a role is a preset of ratings; clicking one sets them --}}
            <div class="ps-roleseg nb-preset" role="group" aria-label="Role">{{#each presets}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setNpcPreset" data-preset="{{key}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div>
            {{#if escAny}}<label class="ps-esctog"><input type="checkbox" name="system.useEscalation" {{#if escOn}}checked{{/if}}> Escalation</label>{{/if}}
            {{#if escOn}}<label class="ps-esctog"><input type="checkbox" name="system.eliteLadder" {{#if ladderOn}}checked{{/if}}> Default ladder</label>{{/if}}
            <span class="ps-right"></span>
            <label class="nb-stat"><span>Level</span><input type="number" min="0" name="system.level" value="{{level}}" aria-label="Level"></label>
            <div class="nb-stat dark"><span>Stage</span><b>{{stage}}</b></div>
            <div class="nb-stat dark"><span>CV</span><b>{{cv}}</b></div>
            <div class="nb-stat"><span>AP</span><b>{{ap}}</b></div>
          </div>
          <div class="nb-sum">{{#each summary}}<div><span>{{k}}</span><b>{{v}}</b></div>{{/each}}</div>
          {{!-- v0.0.308 (Lucas): the Tags first, above every table (some Tags will change the numbers) --}}
          <div class="ps-block nb-tagbar"><div class="ps-bh"><b>Tags</b><span class="ps-bsub">what the creature is (Profane, Undead...): Actions and rules can ask for them</span></div>
            <div class="nb-chips">{{#each @root.npcTags.have}}<span class="nb-chip">{{label}}<a data-action="removeTag" data-tag="{{key}}" aria-label="Remove {{label}}">&times;</a></span>{{else}}<span class="ps-mut">No Tags.</span>{{/each}}
              {{#if @root.npcTags.add.length}}<select class="tagadd nb-add" aria-label="Add a Tag"><option value="">+ Tag</option>{{#each @root.npcTags.add}}<option value="{{key}}">{{label}}</option>{{/each}}</select>{{/if}}</div>
          </div>
          <div class="nb-cols">
            {{#each cols}}
            <div class="nb-col">
              {{#each this}}
              <div class="ps-block nb-blk" style="flex: {{grow}} 0 auto"><div class="ps-bh"><b>{{title}}</b></div>
                {{#each rows}}
                <div class="nb-row" style="--fc:{{color}}">
                  <div class="nb-rh"><b class="nb-nm">{{name}}</b><span class="nb-rt">{{ratingName}}</span><b class="nb-val">{{value}}</b></div>
                  <div class="nb-steps2">{{#each steps}}<button type="button" class="nb-step{{#if on}} on{{/if}}{{#if sel}} sel{{/if}}" data-action="{{../act}}" data-key="{{../key}}" data-rating="{{r}}" data-v="{{r}}" aria-label="{{../name}}: {{tip}}" aria-pressed="{{#if sel}}true{{else}}false{{/if}}"><i class="nb-pip"></i><span>{{v}}</span></button>{{/each}}</div>
                </div>
                {{/each}}
              </div>
              {{/each}}
            </div>
            {{/each}}
          </div>
          {{!-- v0.0.308 (Lucas): the old Stat block as rows like the others; Resist and Weak as chips --}}
          <div class="ps-block nb-frame"><div class="ps-bh"><b>Frame</b><span class="ps-bsub">for rules and Talents that ask; never its Defenses (those come from the ratings)</span></div>
            <div class="nb-frows">{{#each frame}}
              <div class="nb-row" style="--fc:{{color}}">
                <div class="nb-rh"><b class="nb-nm">{{name}}</b><span class="nb-rt">{{ratingName}}</span><b class="nb-val">{{value}}</b></div>
                <div class="nb-steps2">{{#each steps}}<button type="button" class="nb-step{{#if on}} on{{/if}}{{#if sel}} sel{{/if}}{{#if small}} small{{/if}}" data-action="setFrame" data-key="{{../key}}" data-v="{{r}}" aria-label="{{../name}}: {{tip}}" aria-pressed="{{#if sel}}true{{else}}false{{/if}}"><i class="nb-pip"></i><span>{{v}}</span></button>{{/each}}</div>
              </div>{{/each}}
            </div>
          </div>
          {{!-- v0.0.373 (STYLE-2, Lucas: version A): three lines of chips (the subtype's icon and color); v0.0.377 (Lucas): "+ Add" opens the window (dmglines.mjs pickDamageLine), drawn like the Add section was --}}
          <div class="ps-block nb-rw rwA"><div class="ps-bh"><b>Damage: Immune, Resist and Weak</b><button type="button" class="ps-dladd" data-action="dmgLineAdd">+ Add</button><span class="ps-bsub">Resist lowers that type's damage by its number, Weak raises it; Immune ignores it</span></div>
            <div class="rw-lines">{{#each rw.lines}}<div class="rw-line"><span class="rw-k {{kind}}">{{label}}</span><span class="rw-v">{{#each chips}}<span class="rw-chip" style="{{style}}"><i class="{{icon}}" aria-hidden="true"></i><b>{{name}}</b>{{#if n}}<i class="rw-n">{{n}}</i>{{/if}}<a data-action="removeDmgMod" data-kind="{{kind}}" data-sub="{{sub}}" aria-label="Remove {{../label}} {{name}}">&times;</a></span>{{else}}<span class="ps-mut">&mdash;</span>{{/each}}</span></div>{{/each}}</div>
          </div>
          <div class="ps-block nb-atkblk{{#if vsWd}} nb-vswd{{/if}}"><div class="ps-bh"><b>Attack damage</b><span class="ps-bsub">Tier 2 / Tier 3 average, and the dice to write</span><span class="nb-vsw">{{#each vsToggle}}<button type="button" class="nb-vsb vsk-{{key}}{{#if on}} on{{/if}}" data-action="setNbVs" data-vs="{{key}}">{{label}}</button>{{/each}}</span></div>
            {{#if s0}}<p class="nb-how">The turn budget (Stage 0): find the row of the Action's <b>AP and Frequency</b>, then the column of its <b>damage rating</b> (this creature's is highlighted). Each cell is the Action's <b>points</b> and the damage they buy on <b>Tier 2 / Tier 3</b>, written whole (no Modifier added). Take its riders' prices off the points first (Forced Movement 1: 2, Mild 3, Moderate 8, Severe 12, Extreme 18); a ranged attack uses the column to the left; a Basic attack's die explodes (!) on a Standard or an Elite.</p>
            {{else}}<p class="nb-how">Find the row of the Action's <b>AP</b>, then the column of <b>how hard it hits</b> (<b>Medium</b> is normal for a {{roleLabel}}). Each cell is the average damage on <b>Tier 2 / Tier 3</b>, and below it dice that give it with this creature's {{modLabel}}: write those on the Action.</p>{{/if}}
            {{!-- v0.0.309 (Lucas): the sheet's own look (tiles with the rating's color, like the pips), not a table --}}
            <div class="nb-dmg" style="--cols:{{heads.length}}">
              <div class="nb-dh"><span class="nb-dl">AP</span>{{#each heads}}<span class="nb-dhc{{#if med}} med{{/if}}" style="--rc:{{color}}">{{label}}</span>{{/each}}</div>
              {{#each attacks}}<div class="nb-dr"><div class="nb-dl"><b>{{label}}</b><small>{{sub}}</small></div>{{#each cells}}<div class="nb-dc{{#if med}} med{{/if}}" style="--rc:{{color}}"><b>{{v}}</b><small>{{dice}}</small></div>{{/each}}</div>{{/each}}
            </div>
            {{#unless s0}}<ul class="nb-rules"><li><b>Vs. WD:</b> the same table; the dice use the Power Modifier ({{powerMod}}) instead, to [R] Resolve unless the Action writes [V] (the switch above shows them).</li><li><b>Conditions</b> cost damage: a Mild one takes the column 1 step to the left, Moderate 2, Severe 3.</li><li><b>Area Save Actions:</b> about half the damage, to each creature in the area (DC 11 + the Modifier).</li><li><b>Reactions:</b> a Trigger deals one column more than an Action of the same AP; an Interrupt the same.</li></ul>{{/unless}}
          </div>
        </div>
        {{/with}}
      </div>

      {{!-- v0.0.455 (group 4: "the Loot tab proposed"): the Inventory's lines, Give… on each (inventory.mjs lootHtml) --}}
      <div class="tab" data-tab="loot">
        <div class="ps-stack">{{{pc.lootHtml}}}</div>
      </div>
      {{/if}}

      <div class="tab" data-tab="notes">
        <div class="ps-stack notes">
          <span class="ps-h2">Appearance</span>
          <div class="nbox">{{formInput notesFields.appearance enriched=notesEnriched.appearance value=system.appearance name="system.appearance" toggled=true}}</div>
          <span class="ps-h2">Background</span>
          <div class="nbox">{{formInput notesFields.background enriched=notesEnriched.background value=system.background name="system.background" toggled=true}}</div>
          <span class="ps-h2">Notes</span>
          <div class="nbox">{{formInput notesFields.notes enriched=notesEnriched.notes value=system.notes name="system.notes" toggled=true}}</div>
          {{#if isGM}}
          <span class="ps-h2">GM notes <small class="ps-mut"><i class="fa-solid fa-eye-slash"></i> only the GM sees them</small></span>
          <div class="nbox gm">{{formInput notesFields.gmNotes enriched=notesEnriched.gmNotes value=system.gmNotes name="system.gmNotes" toggled=true}}</div>
          {{/if}}
        </div>
      </div>
      </div>
    </section>
  </div>
</div>
