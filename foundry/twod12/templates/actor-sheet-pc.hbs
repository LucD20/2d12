{{!-- PACK SHEET (v0.0.289): the character sheet, Lucas's approved design (foundry/mockups/sheet-prototype.html). The NPC sheet keeps actor-sheet.hbs. --}}
{{#*inline "usebtn"}}
{{#if unloaded}}<button type="button" class="ps-use" data-action="reloadFor" data-tooltip="Unloaded: Reload first (1 AP)" aria-label="Reload"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
{{else if off}}<button type="button" class="ps-use dis" data-action="useAction" data-off="{{offWhy}}" data-tooltip="{{offWhy}} (click to use it anyway)" aria-label="{{name}}: {{offWhy}}. Use it anyway">{{#if weapon}}<i class="fa-solid fa-khanda" aria-hidden="true"></i><small>{{grip}}</small>{{else}}Use{{/if}}</button>
{{else if grant}}<button type="button" class="ps-use{{#if reaction}} rx{{/if}}" data-action="useAction" {{#if grant.effectId}}data-grant-effect="{{grant.effectId}}" data-grant-index="{{grant.index}}"{{/if}} data-tooltip="{{grant.tip}}" aria-label="Use {{name}} (granted)">Use</button>
{{else if handBtns}}<span class="ps-hands">{{#each handBtns}}{{#if off}}<button type="button" class="ps-use dis" data-action="handBlocked" data-weapon-id="{{id}}" data-hand="{{hand}}" data-tooltip="{{tip}}" aria-label="{{tip}}"><i class="fa-solid fa-khanda" aria-hidden="true"></i><small>{{grip}}</small></button>{{else}}<button type="button" class="ps-use wpn{{#if ../reaction}} rx{{/if}}{{#if warn}} warn{{/if}}" data-action="useWith" data-weapon-id="{{id}}" data-tooltip="{{tip}}" aria-label="{{tip}}"><i class="fa-solid fa-khanda" aria-hidden="true"></i><small>{{grip}}</small></button>{{/if}}{{/each}}</span>
{{else}}<button type="button" class="ps-use{{#if reaction}} rx{{/if}}" data-action="useAction" data-tooltip="{{useTip}}" aria-label="{{useTip}}">Use</button>{{/if}}
{{/inline}}
{{#*inline "srow"}}
<div class="ar ps-row{{#if off}} off{{/if}}{{#if open}} open{{/if}}{{#if lines.strike}} strike{{/if}}{{#if freqLine}} lnfreq{{/if}}{{#if basicAtk}} basicatk{{/if}}" data-item-id="{{id}}"{{#if freqLine}} style="{{freqLine.style}}"{{/if}}>
  <div class="ps-line" data-action="toggleCard">
    <span class="ps-name"><a class="ps-nm" role="button" tabindex="0" aria-expanded="{{#if open}}true{{else}}false{{/if}}">{{name}}{{{auto}}}</a>{{#if sub}}<span class="ps-sub">{{sub}}</span>{{/if}}{{#if fav}}<i class="fa-solid fa-star ps-fav" data-tooltip="Favorite (right-click the row to change)" aria-label="Favorite"></i>{{/if}}</span>
    <span class="ps-c"><span class="ps-pill{{#if outline}} line{{/if}}" style="--fc:{{fc}}">{{cost}}</span></span>
    <span class="ps-c ps-dist"{{#if distTip}} data-tooltip="{{distTip}}"{{/if}}>{{dist}}{{#if distTip}} <i class="fa-solid fa-circle-info dist-i"></i>{{/if}}</span>
    <span class="ps-c">{{#if vs}}<span class="ps-vs{{#if vsKind}} vsk-{{vsKind}}{{/if}}">{{vs}}</span>{{/if}}</span>
    <span class="ps-c">{{> usebtn}}</span>
  </div>
  <div class="ar-card"></div>
</div>
{{/inline}}
{{#*inline "sect"}}
<div class="ps-block {{cls}}">
  <div class="ps-bh"><span class="ps-dot" style="background:{{dot}}"></span><b>{{title}}</b>{{#if sub}}<span class="ps-bsub">{{sub}}</span>{{/if}}</div>
  <div class="atable" data-list="{{list}}">{{#each rows}}{{> srow}}{{/each}}</div>
</div>
{{/inline}}
{{#*inline "senses"}}<span class="ps-senses">{{#each pc.strip.senses}}<span class="ps-sense" data-tooltip="{{tip}}">{{label}}</span>{{/each}}</span>{{/inline}}
{{#*inline "brow"}}
<div class="ar ps-brw{{#if open}} open{{/if}}" data-item-id="{{id}}">
<div class="ps-brow" {{#if id}}data-action="toggleCard"{{/if}}>
  <span class="ps-slot">{{slot}}</span>
  <span class="ps-bname">{{#if id}}<i class="fa-solid fa-grip-vertical grip" aria-hidden="true"></i>{{/if}}<b class="ps-nm" {{#if id}}role="button" tabindex="0"{{/if}}>{{name}}</b>{{#if id}}<span class="ps-bctl"><a data-action="openItem" data-tooltip="Edit" aria-label="Edit {{name}}"><i class="fa-solid fa-pen-to-square"></i></a><a data-action="confirmDelete" data-tooltip="Remove" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</span>
  <span>{{#if cost}}<span class="ps-pill" style="--fc:{{fc}}">{{cost}}</span>{{/if}}</span>
  <span class="ps-bfreq">{{freq}}</span>
</div>
<div class="ar-card"></div>
</div>
{{/inline}}
<div class="twod12 sheet pcs{{#if pc.npc}} npcs{{#if pc.strip.elite}} elite{{/if}}{{/if}}{{#if pc.down.down}} isdown{{/if}}{{#if pc.statblock}} sbs{{/if}}">
  {{!-- v0.0.375 (STYLE-2): the one-page NPC sheet (NpcStatBlockSheet) shares this template: no head, strip or side panel; its Main tab is the stat block --}}
  {{#unless pc.statblock}}
  <header class="ps-head">
    <img class="ps-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="Portrait of {{actor.name}}" data-tooltip="Change the portrait">
    <div class="ps-id">
      <div class="ps-nameline"><input class="ps-nameinput" type="text" name="name" value="{{actor.name}}" placeholder="Name" aria-label="Name">{{#if pc.npc}}<span class="ps-role r-{{pc.head.roleKey}}">{{pc.head.role}}</span>{{/if}}</div>
      {{#if pc.npc}}<div class="ps-line1"><span>Level {{system.level}}</span><span>&middot;</span><b class="ps-stage">Stage {{system.stage}}</b><span>&middot;</span><span>{{pc.head.size}}</span><span>&middot;</span><span data-tooltip="{{npcCvTip}}">CV <b class="ps-stage">{{pc.head.cv}}</b></span>{{> senses}}</div>
      {{else}}<div class="ps-line1">
        <span>Level {{system.level}}</span>
        <span>&middot;</span><b class="ps-stage">Stage {{system.stage}}</b>
        <span>&middot;</span>{{#if pc.head.species}}<a data-action="openItem" data-item-id="{{pc.head.species.id}}" data-tooltip="Open the species">{{pc.head.species.name}}</a>{{else}}<em>No species</em>{{/if}}
        {{#if pc.head.cls}}<a data-action="openItem" data-item-id="{{pc.head.cls.id}}" data-tooltip="Open the class">{{pc.head.cls.name}}</a>{{else}}<em>No class</em>{{/if}}
        <span>&middot;</span><span>{{pc.head.size}}</span>
        {{> senses}}
      </div>{{/if}}
    </div>
    <div class="ps-htools">
      {{#if pc.npc}}{{#if pc.head.isGM}}<button type="button" class="ps-btn3" data-action="postStatBlock" data-tooltip="Post the stat block to the chat (GM only)">Post stat block</button>{{/if}}{{/if}}
      <button type="button" class="ps-icon" data-action="editSenses" data-tooltip="Senses: Sight, Hearing and special senses" aria-label="Senses"><i class="fa-solid fa-eye"></i></button>
      {{#if (eq pc.head.combat.mode "roll")}}<button type="button" class="ps-init" data-action="rollInitiative" data-tooltip="Roll Initiative (the system's Initiative)">Roll Initiative</button>
      {{else if (eq pc.head.combat.mode "status")}}<span class="ps-incombat">{{pc.head.combat.text}}</span>
      {{else}}<button type="button" class="ps-init dis" aria-disabled="true" data-tooltip="No active combat: the GM starts an encounter first">Roll Initiative</button>{{/if}}
    </div>
  </header>

  {{#if pc.strip.inCombat}}
  {{!-- v0.0.349 (Lucas, playtest 4, Step 4): On you where Guard was; Escalation then Hands; Action Points at the right (where Senses was) with the
        3 Strike pips under them (no "X of 4 · Reaction ready"); Guard is a numbered shield in the Health header; Senses under the name --}}
  <div class="ps-strip v349">
    {{#if pc.npc}}
    {{#if pc.strip.elite}}<div class="ps-cell">
      <span class="ps-k">Elite Escalation {{pc.strip.esc.n}}</span>
      <span class="ps-rungs">{{#each pc.strip.eliteRungs}}<a class="rung{{#if lit}} lit{{/if}}" data-action="setEscalation" data-n="{{n}}" role="button" data-tooltip="{{tip}} Click to correct the level.">{{label}}</a>{{/each}}</span>
      <span class="ps-s">{{pc.strip.phases}}</span>
    </div>{{/if}}
    {{else}}
    <div class="ps-cell">
      <span class="ps-k">Escalation {{pc.strip.esc.n}}{{#if pc.strip.esc.momentum}} <span class="ps-mom" data-tooltip="This encounter started at Escalation 2 (Momentum)">Momentum</span>{{/if}}</span>
      <span class="ps-rungs">{{#each pc.strip.esc.rungs}}<a class="rung{{#if lit}} lit{{/if}}" data-action="setEscalation" data-n="{{n}}" role="button" data-tooltip="Escalation {{n}}: click to correct the level">{{label}}</a>{{/each}}</span>
      <span class="ps-s">{{#if pc.strip.esc.hooks}}Hooks still available: {{pc.strip.esc.hooks}}{{else}}No hooks left this encounter{{/if}}</span>
    </div>
    <div class="ps-cell">
      <span class="ps-k">Hands</span>
      <span class="ps-tiles">{{#each pc.hands.tiles}}<button type="button" class="ps-tile{{#if wide}} wide{{/if}}{{#if free}} free{{/if}}{{#if warn}} warn{{/if}}" data-hand-tile="{{hand}}" data-tooltip="{{tip}}" aria-label="{{tip}}"><span>{{name}}</span><b>{{grip}}</b></button>{{/each}}</span>
    </div>
    {{/if}}
    <div class="ps-cell ps-apcell">
      <span class="ps-k">Action Points</span>
      <span class="ps-pips" data-tooltip="{{pc.strip.ap.tip}}">{{#each pc.strip.ap.pips}}{{#if (eq k "slowed")}}<span class="pip slowed" data-tooltip="{{../pc.strip.ap.slowedTip}}" aria-label="{{../pc.strip.ap.slowedTip}}">&times;</span>{{else}}<a class="pip {{k}}" data-action="setApPip" data-n="{{n}}" role="button" aria-label="AP {{n}}"></a>{{/if}}{{/each}}<span class="pip-sep"></span><a class="pip rap{{#if pc.strip.ap.rap}} on{{/if}}" data-action="toggleRap" role="button" data-tooltip="Reaction AP: {{#if pc.strip.ap.rap}}ready{{else}}used{{/if}} (click to correct)" aria-label="Reaction AP"></a></span>
      <span class="ps-strk sm" data-tooltip="Strikes left this turn: {{pc.strip.strikesLeft}} of 3 ({{pc.strip.strikes}})" aria-label="Strikes left this turn: {{pc.strip.strikesLeft}} of 3">{{#each pc.strip.strikePips}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      {{#if pc.strip.nextBane}}<span class="ps-s bane">{{pc.strip.nextBane}}</span>{{/if}}
    </div>
  </div>
  {{else}}
  <div class="ps-strip out{{#if pc.npc}} npc{{/if}}">
    <div class="ps-cell row"><span class="ps-k">Out of combat</span><span>AP, Guard and Escalation appear when {{#if pc.npc}}it joins a combat{{else}}Initiative is rolled{{/if}}</span></div>
    {{#unless pc.npc}}<div class="ps-cell">
      <span class="ps-k">Hands</span>
      <span class="ps-tiles">{{#each pc.hands.tiles}}<button type="button" class="ps-tile{{#if wide}} wide{{/if}}{{#if free}} free{{/if}}{{#if warn}} warn{{/if}}" data-hand-tile="{{hand}}" data-tooltip="{{tip}}" aria-label="{{tip}}"><span>{{name}}</span><b>{{grip}}</b></button>{{/each}}</span>
    </div>{{/unless}}
  </div>
  {{/if}}

  {{!-- v0.0.373 (STYLE-2, Lucas: "we already have the effects tab and this grows too much with effects"): no "On you" / "On it" here or in the strip --}}

  {{/unless}}
  <div class="ps-body">
    {{#unless pc.statblock}}
    <aside class="ps-side np">
      <section class="ps-sec">
        {{#with pc.health}}
        <div class="ps-hh"><span class="ps-k">Health {{pool}}</span><a class="ps-shield np-guardbtn{{#unless @root.pc.strip.guard.total}} zero{{/unless}}" role="button" data-tooltip="{{@root.pc.strip.guard.tip}}" aria-label="Guard {{@root.pc.strip.guard.total}}"><b>{{@root.pc.strip.guard.total}}</b></a>{{#if down.down}}<span class="ps-dmg"><b>{{damage}}</b> / {{pool}} damage</span>{{else}}<span class="ps-todown"><b>{{toDown}}</b> to Down</span>{{/if}}</div>
        {{#if down.down}}
        <div class="ps-downbox">
          <div class="ps-dt"><b>DOWN &middot; {{down.title}}</b>{{#if down.tableRolled}}<span>{{down.tableRolled}}</span>{{/if}}</div>
          <span class="ps-dn">{{down.note}}</span>
          {{#if down.kind}}
          <div class="ps-dbtns">
            <button type="button" class="ps-dkeep" data-action="downChoice" data-choice="fight" {{#if down.keepOff}}aria-disabled="true" data-tooltip="{{down.keepOff}}"{{else}}data-tooltip="Keep fighting ({{down.title}})"{{/if}}>Keep fighting</button>
            <button type="button" class="ps-dline" data-action="downChoice" data-choice="collapse" {{#if down.collapseOff}}aria-disabled="true" data-tooltip="{{down.collapseOff}}"{{else}}data-tooltip="{{down.collapseWord}}: fall Unconscious"{{/if}}>{{down.collapseWord}}</button>
          </div>
          <button type="button" class="ps-dline wide" data-action="downCheck" data-tooltip="The end-of-turn {{down.check}} Check (it also runs by itself when your turn ends)">End-of-turn {{down.check}} Check</button>
          {{/if}}
        </div>
        {{/if}}
        {{#each bars}}
        <div class="ps-bar">
          <div class="ps-barh"><span class="ps-bl"><b style="color:{{label}}">{{name}}</b>{{#if tag}}<span class="ps-tag" style="background:{{bg}}">{{tag}}</span>{{/if}}</span><a class="hpnum" data-action="hpEdit" data-pool="{{pool}}" role="button" data-tooltip="Type the {{name}} damage">{{value}} / {{max}}</a></div>
          <div class="ps-track np-track" data-pool="{{pool}}" data-tooltip="{{tip}}"><span class="sl" style="width:{{seg.lethal}}%;background:{{solid}}"></span><span class="sn" style="width:{{seg.nonlethal}}%;--a:{{solid}};--b:{{dark}}"></span></div>
        </div>
        {{/each}}
        {{#unless ../pc.npc}}<div class="ps-foot">{{#if down.down}}Dominant Damage: <b style="color:{{domColor}}">{{dominant}}</b> &rarr; {{down.title}}{{else}}Dominant Damage: <b style="color:{{domColor}}">{{dominant}}</b>{{/if}}</div>{{/unless}}
        {{/with}}
      </section>

      {{#unless pc.npc}}<section class="ps-sec line">
        <div class="ps-hh"><span class="ps-k">Rally</span><span class="ps-rally">{{pc.rally.left}} / {{pc.rally.max}} &middot; Each heals {{pc.rally.heal}}</span></div>
        <span class="ps-rpips" data-tooltip="Rally Points: your class's Rally value + your Stage. Each removes {{pc.rally.heal}} damage (a quarter of your Health Pool, rounded up). Only a Rest restores them.">{{#each pc.rally.pips}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      </section>{{/unless}}

      <section class="ps-sec line">
        <span class="ps-k">Defenses</span>
        <div class="ps-g2">{{#each pc.defs.main}}<div class="ps-box big" data-tooltip="{{tip}}"><b class="{{cls}}">{{value}}</b><span>{{label}}</span></div>{{/each}}</div>
        <div class="ps-g4 small">{{#each pc.defs.vs}}<div class="ps-box" data-tooltip="{{tip}}"><b>{{value}}</b><span>{{label}}</span></div>{{/each}}</div>
      </section>
      {{{pc.dmgHtml}}}

      <section class="ps-sec line">
        <span class="ps-k">Attributes</span>
        <div class="ps-g4">{{#each pc.attrs}}<button type="button" class="ps-box btn" data-action="rollAttr" data-key="{{key}}" data-tooltip="Click: {{label}} Check · Shift-click: {{label}} Save" aria-label="{{label}} {{value}}"><b>{{value}}</b><span>{{label}}</span></button>{{/each}}</div>
      </section>

      <section class="ps-sec">
        <span class="ps-k">Movement</span>
        <div class="ps-g4">{{#each pc.move}}<div class="ps-box btn" data-tooltip="{{tip}}"><b class="{{cls}}">{{value}}</b><span>{{label}}</span></div>{{/each}}</div>
      </section>

      <section class="ps-sec line">
        <span class="ps-k">{{#if pc.npc}}Modifier{{else}}Modifiers{{/if}} &middot; Save DC</span>
        <div class="ps-mods">{{#each pc.mods}}<span data-tooltip="{{tip}}">{{label}} <span class="ps-mut">{{attr}}</span></span><b>{{value}}</b><span class="ps-dc">{{dc}}</span>{{/each}}</div>
        {{#if pc.modConflict}}<span class="ps-mut small">{{pc.modConflict}}</span>{{/if}}
      </section>

      {{#unless pc.npc}}<section class="ps-wounds">
        {{#each pc.wounds}}
        <div class="ps-wb {{key}}">
          <div class="ps-wh"><span>{{label}}</span><input type="number" min="0" name="system.{{key}}Wounds" value="{{count}}" aria-label="{{label}}" data-tooltip="{{label}}: each one adds 1d6 to its Table"></div>
          {{#each named}}<button type="button" class="ps-wchip" data-effect-id="{{id}}" data-action="openEffect" data-tooltip="Open the effect">{{name}}</button>{{else}}<span class="ps-mut small">none named</span>{{/each}}
          <button type="button" class="ps-wroll" data-action="rollTable" data-kind="{{table}}" data-tooltip="Roll on the {{tableName}} Table">Roll {{tableName}}</button>
        </div>
        {{/each}}
      </section>{{/unless}}
    </aside>
    {{/unless}}

    <section class="ps-main mn">
      {{#if pc.statblock}}{{{statblockPlate}}}{{/if}}
      <nav class="ps-tabs" aria-label="Sheet tabs">
        {{#unless pc.statblock}}<a class="tabbtn" data-action="switchTab" data-tab-target="favorites" data-tooltip="Favorites" aria-label="Favorites" role="tab" tabindex="0"><i class="fa-regular fa-star"></i></a>{{/unless}}
        {{#each pc.tabs}}<a class="tabbtn" data-action="switchTab" data-tab-target="{{k}}" role="tab" tabindex="0">{{l}}{{#if n}} <span class="tabcount">{{n}}</span>{{/if}}</a>{{/each}}
      </nav>
      <div class="ps-scroll">
      {{#if pc.statblock}}<div class="tab" data-tab="main">{{{statblockHtml}}}</div>{{/if}}

      <div class="tab" data-tab="favorites">
        {{#if pc.favRows.length}}
        <div class="ps-colh"><span>Favorite</span><span>Cost</span><span>Distance</span><span>Vs.</span><span></span></div>
        <div class="ps-block"><div class="atable" data-list="favorites">{{#each pc.favRows}}{{> srow}}{{/each}}</div></div>
        {{else}}<div class="ps-empty"><i class="fa-regular fa-star"></i> Right-click an Action on the Actions tab and choose Favorite to keep it here. Drag the rows to put them in your order.</div>{{/if}}
      </div>

      <div class="tab" data-tab="actions">
        {{#if pc.npc}}<div class="ps-ih tools"><span class="ps-ibtns"><button type="button" class="ps-btn2" data-action="generateAction"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate Action</button><button type="button" class="ps-btn2" data-action="browseCompendium"><i class="fa-solid fa-book-open"></i> Browse compendium</button><button type="button" class="ps-btn2" data-action="newAction"><i class="fa-solid fa-plus"></i> New Action</button></span></div>{{/if}}
        <div class="ps-colh"><span>Action</span><span>Cost</span><span>Distance</span><span>Vs.</span><span></span></div>
        <div class="ps-stack">
          {{#each pc.sections}}{{> sect list="actions"}}{{else}}<div class="ps-empty">No Actions yet. Drag Actions, Features, Talents or Weapons onto this sheet.</div>{{/each}}
        </div>
        <div class="ps-basic">
          <div class="ps-basich"><span class="ps-h2">Basic Actions</span>{{#unless pc.npc}}<span class="ps-legend"><i class="sw" style="--lnf:#4c7a2e"></i> At-will <i class="sw" style="--lnf:#2c5d9e"></i> Once per round <i class="sw" style="--lnf:var(--tw-strike)"></i> Strike</span>{{/unless}}
            <a class="ps-upd" data-action="addBasic" data-tooltip="Replace the Basic Actions with the compendium's current versions (adds the missing ones)">{{#if missingBasic}}Add{{else}}Update{{/if}} Basic Actions</a></div>
          <div class="ps-bgrid">
            {{#each pc.basic}}
            <div class="ps-bcol"><span class="ps-bgh">{{label}}</span>
              {{#each rows}}
              <div class="ar ps-bx{{#if off}} off{{/if}}{{#if open}} open{{/if}}" data-item-id="{{id}}">
                <button type="button" class="ps-bxbtn {{lines.cls}}" style="{{lines.style}}" {{#if off}}data-action="useAction" data-off="{{offWhy}}" data-tooltip="{{offWhy}} (click to use it anyway)"{{else}}{{#if weaponId}}data-action="useWith" data-weapon-id="{{weaponId}}"{{else}}data-action="useAction"{{/if}} data-tooltip="{{tip}}"{{/if}} aria-label="{{name}}{{#if off}}: {{offWhy}}{{/if}}">
                  <span class="ps-bxl"><span class="ps-bxn">{{name}}</span>{{#if next}}<span class="ps-bxnext">{{next}}</span>{{/if}}{{#if off}}<span class="ps-bxwhy">{{offWhy}}</span>{{/if}}</span>
                  {{#if off}}<span class="ps-bxno" aria-hidden="true">&#8856;</span>{{else}}<b>{{cost}}</b>{{/if}}
                </button>
                <div class="ar-card"></div>
              </div>
              {{/each}}
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      <div class="tab" data-tab="effects">
        <div class="ps-stack">
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#a8322d"></span><b>Conditions</b></div>
            {{#each pc.effects.conditions}}
            <div class="ps-erow" {{#if id}}data-effect-id="{{id}}"{{/if}}{{#if counter}} data-counter="1"{{/if}}>
              <span class="ps-eic {{tone}}">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initial}}{{/if}}</span>
              <b>{{#if id}}<a data-action="openEffect" data-tooltip="Open the effect">{{name}}</a>{{else}}{{name}}{{/if}}</b>
              <span class="ps-etext">{{{text}}}</span>
              <span class="ps-epill">{{pill}}</span>
              <span class="ps-ectl">{{#if counter}}<a data-action="exhaustedDown" aria-label="Exhausted −1" data-tooltip="Exhausted −1">&minus;</a><a data-action="exhaustedUp" aria-label="Exhausted +1" data-tooltip="Exhausted +1">+</a>{{/if}}{{#if id}}<a data-action="deleteEffect" data-tooltip="Remove" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>
            </div>
            {{else}}<div class="ps-erow none">No conditions.</div>{{/each}}
          </div>
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#1b2433"></span><b>Effects</b></div>
            {{#each pc.effects.effects}}
            <div class="ps-erow{{#if off}} offfx{{/if}}" data-effect-id="{{id}}">
              <span class="ps-eic good">{{#if img}}<img src="{{img}}" alt="">{{else}}+{{/if}}</span>
              <b><a data-action="openEffect" data-tooltip="Open the effect">{{name}}</a></b>
              <span class="ps-etext">{{{text}}}{{#if source}} <span class="ps-mut">{{source}}.</span>{{/if}}</span>
              <span class="ps-epill">{{pill}}</span>
              <span class="ps-ectl"><a data-action="deleteEffect" data-tooltip="Remove" aria-label="Remove {{name}}"><i class="fa-solid fa-xmark"></i></a></span>
            </div>
            {{else}}<div class="ps-erow none">No effects on you.</div>{{/each}}
          </div>
          <div class="ps-drop edrop">Drop an effect or a condition here to apply it</div>
        </div>
      </div>

      <div class="tab" data-tab="items">
        <div class="ps-stack">
          <div class="ps-ih"><span class="ps-h2">Weapons</span><span class="ps-ibtns"><button type="button" class="ps-btn2" data-action="generateWeapon"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate Weapon</button><button type="button" class="ps-btn2" data-action="newGear"><i class="fa-solid fa-plus"></i> New Item</button></span></div>
          <div class="olist ps-ilist" data-order-flag="itemOrder">
          {{#each pc.weapons}}
          <div class="lrow ps-irow w{{#if dropped}} dropped{{/if}}" data-item-id="{{id}}">
            <div class="ps-imain"><span><i class="fa-solid fa-grip-vertical grip" aria-hidden="true"></i><a class="ps-iname" data-action="openItem" data-tooltip="Open the weapon">{{name}}</a>{{#if unloaded}} <a class="ps-warnchip" data-action="reloadWeapon" data-tooltip="Unloaded: Reload (1 AP)">Unloaded</a>{{/if}}{{#if warn}} <span class="ps-warnchip amber" data-tooltip="A Two-handed weapon in one hand: 3 Banes on its [Strike, Weapon] Actions">1H</span>{{/if}}</span><span class="ps-isub">{{sub}}</span></div>
            <div class="ps-tiers">{{#each tiers}}<span><small>{{l}}</small><b>{{v}}</b></span>{{/each}}</div>
            <div class="ps-imast">Mastery <b>{{mastery}}</b><br><span class="ps-mut">Technique {{#if techOn}}unlocked{{else}}locked{{/if}}</span></div>
            <div class="ps-seg" role="group" aria-label="Where {{name}} is">{{#each seg}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setWhere" data-where="{{v}}" data-tooltip="{{tip}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{l}}</button>{{/each}}</div>
          </div>
          {{else}}<div class="ps-empty">No weapons. Drag one here, or generate one.</div>{{/each}}
          </div>
          <span class="ps-h2">Armor</span>
          <div class="olist ps-ilist" data-order-flag="itemOrder">
          {{#each pc.armor}}
          <div class="lrow ps-irow a{{#if dropped}} dropped{{/if}}" data-item-id="{{id}}">
            <div class="ps-imain"><span><i class="fa-solid fa-grip-vertical grip" aria-hidden="true"></i><a class="ps-iname" data-action="openItem" data-tooltip="Open the armor">{{name}}</a></span><span class="ps-isub {{#if trained}}ok{{else}}bad{{/if}}">{{trainText}}</span></div>
            <div class="ps-aval">Armor value <b>{{value}}</b> &rarr; AD <b>{{ad}}</b> &middot; Ward <b>{{ward}}</b></div>
            <div class="ps-seg" role="group" aria-label="Where {{name}} is">{{#each seg}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setWhere" data-where="{{v}}" data-tooltip="{{tip}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{l}}</button>{{/each}}</div>
          </div>
          {{else}}<div class="ps-empty">No armor: you are Unarmored (Armor 11). Drag an armor here.</div>{{/each}}
          </div>
          {{#if pc.untrained}}<div class="ps-warnbox">{{pc.untrained}}</div>{{/if}}
          <div class="ps-ih"><span class="ps-h2">Gear and loot</span><span class="ps-mut"><label>Coins <input type="number" min="0" name="system.coins" value="{{system.coins}}" aria-label="Coins"></label> &middot; Weight {{gearWeight}}</span></div>
          <div class="olist ps-glist" data-order-flag="itemOrder">
            {{#each gear}}
            <div class="grow ps-grow" data-item-id="{{id}}">
              <i class="fa-solid fa-grip-vertical grip" aria-hidden="true"></i>
              <span class="g-name"><img src="{{img}}" alt="" data-action="sendItem" data-tooltip="Send to chat"><a data-action="openItem" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>{{name}}</a></span>
              <input class="gq" type="number" min="0" value="{{qty}}" data-item-id="{{id}}" aria-label="Quantity of {{name}}">
              <span data-tooltip="{{eachTip}}">{{weight}}</span><span data-tooltip="{{eachTip}}">{{cost}}</span>
              <span class="g-btns"><a data-action="openItem" data-tooltip="Edit" aria-label="Edit {{name}}"><i class="fa-solid fa-pen-to-square"></i></a><a data-action="confirmDelete" data-tooltip="Remove" aria-label="Remove {{name}}"><i class="fa-solid fa-trash"></i></a></span>
            </div>
            {{else}}<div class="ps-empty">Nothing yet. Drag gear here, or use New Item.</div>{{/each}}
          </div>
        </div>
      </div>

      <div class="tab" data-tab="build">
        <div class="ps-stack">
          {{#if pc.build.banner}}<div class="ps-banner"><b>{{pc.build.banner.count}} card{{#unless pc.build.banner.one}}s{{/unless}} fill no slot:</b><span>{{pc.build.banner.names}}</span><button type="button" data-action="reviewSlots">Review</button></div>{{/if}}
          <div class="ps-lvlbar"><label class="ps-lvl">Level <input type="number" min="0" name="system.level" value="{{system.level}}" aria-label="Level" data-tooltip="Your level: raising it opens the class window for the new level's choices"></label><span class="ps-mut">Stage {{system.stage}}</span></div>
          <div class="ps-g2 wide">
            {{#each pc.build.cards}}
            <div class="ps-bcard">
              <div class="ps-bch"><span><small>{{kind}}</small> <b>{{name}}</b></span>{{#if choices}}<button type="button" data-action="{{choices}}" data-tooltip="{{choicesTip}}">Choices</button>{{/if}}</div>
              <div class="ps-bcb">
                <div class="ps-chips">{{#each chips}}<span class="ps-mchip {{cls}}">{{this.t}}</span>{{/each}}</div>
                <div class="ps-g4">{{#each stats}}<div class="ps-lbox"><b>{{v}}</b><span>{{l}}</span></div>{{/each}}</div>
              </div>
            </div>
            {{else}}<div class="ps-empty">Drop a Species and a Class on this sheet.</div>{{/each}}
          </div>
          {{#each pc.build.levels}}
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#6b665a"></span><b>{{title}}</b></div>
            <div class="flist olist ps-blist" data-order-flag="featureOrder">{{#each rows}}{{> brow}}{{/each}}</div>
          </div>
          {{/each}}
          {{#if pc.build.esc.length}}
          <div class="ps-block esc"><div class="ps-bh"><span class="ps-dot" style="background:#c9821f"></span><b>Escalation</b></div>
            {{#each pc.build.esc}}{{> brow}}{{/each}}
          </div>
          {{/if}}
          {{#if pc.build.other.length}}
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#6b665a"></span><b>Other</b><span class="ps-bsub">given by hand (not from your class table)</span></div>
            {{#each pc.build.other}}{{> brow}}{{/each}}
          </div>
          {{/if}}
          {{#if pc.build.next.length}}
          <div class="ps-block"><div class="ps-bh"><span class="ps-dot" style="background:#6b665a"></span><b>Next levels</b></div>
            <div class="ps-next">{{#each pc.build.next}}<span>Level {{level}}</span><span>{{text}}</span>{{/each}}</div>
          </div>
          {{/if}}
          <div class="flist" data-list="talents">
            {{#each pc.build.emptySlots}}<div class="tfslot talentslot" data-slot="{{key}}"><i class="fa-solid fa-plus"></i> Drop a Talent here <span class="tfslotsrc">from {{feature}}</span></div>{{/each}}
            <div class="tfslot talentslot extra" data-slot=""><i class="fa-solid fa-plus"></i> Drop an extra Talent here (the GM's)</div>
          </div>
        </div>
      </div>

      <div class="tab" data-tab="mastery">
        <div class="ps-stack">
          <div class="ps-ih"><span class="ps-h2">Weapon Mastery</span><span class="ps-mut">A Tier 3 with a weapon in an encounter: +1 Mastery with its kind</span></div>
          {{#each startMastery}}<div class="ps-note"><i class="fa-solid fa-bullseye"></i> <b>{{from}}:</b> {{#if chosen}}{{chosen}} ({{value}} Mastery from the start){{else}}<a data-action="chooseStartMastery" data-item="{{itemId}}">choose your {{traitName}} weapon</a> to start with {{value}} Mastery with it{{/if}}</div>{{/each}}
          {{#each pc.mastery}}
          <div class="ps-block"><div class="ps-bh"><b>{{name}}</b><span class="ps-bsub">{{note}}</span>{{#if @root.isGMUser}}<span class="ps-gmstep"><a data-action="masteryStep" data-key="{{key}}" data-d="-1" data-tooltip="1 less (GM)" aria-label="1 less"><i class="fa-solid fa-minus"></i></a><a data-action="masteryStep" data-key="{{key}}" data-d="1" data-tooltip="1 more (GM)" aria-label="1 more"><i class="fa-solid fa-plus"></i></a></span>{{/if}}</div>
            {{#each rows}}
            <div class="ps-mrow{{#if muted}} muted{{/if}}"><b>{{name}}</b>
              <div class="ps-mbar"><div class="ps-mtrack"><span style="width:{{pct}}%"></span>{{#each marks}}<i style="left:{{at}}%" data-tooltip="{{t}}"></i>{{/each}}</div><div class="ps-mlab">{{#each marks}}<span style="left:{{at}}%">{{l}}</span>{{/each}}</div></div>
              <span class="ps-mnum">{{value}} / {{next}}</span>
            </div>
            {{/each}}
          </div>
          {{else}}<div class="ps-empty">No Mastery yet: add a weapon to this character and it shows here.</div>{{/each}}
          <div class="ps-mut">Technique (3): the weapon's Weapon Technique, used only with that weapon while you wield it. Expert (8): once each turn, draw, stow or change the grip of the weapon without Interact. Master (15): from level 8, one more [W] with the weapon.</div>
        </div>
      </div>

      <div class="tab" data-tab="upkeep">
        <div class="ps-stack">
          <div class="ps-ih"><span class="ps-h2">Recovery</span><span class="ps-mut">each button asks to confirm and posts a chat line</span><span class="ps-right">Exhausted <b>{{pc.upkeep.exhausted}}</b> &middot; last Sleep <b>{{pc.upkeep.lastSleep}}</b></span></div>
          <div class="ps-g3">
            {{#each pc.upkeep.cards}}
            <div class="ps-rcard" style="--rc:{{color}}">
              <div class="ps-rch"><b>{{name}}</b><span>{{time}}</span></div>
              <span>{{text}}</span>
              {{#if now}}<span class="ps-mut {{nowCls}}">{{now}}</span>{{/if}}
              <button type="button" data-action="recover" data-k="{{k}}" {{#if off}}aria-disabled="true" class="dis" data-tooltip="{{off}}"{{/if}}>{{button}}</button>
            </div>
            {{/each}}
          </div>
          <span class="ps-h2">Upkeep</span>
          <div class="ps-placeholder"><b>[Upkeep mechanics: placeholder]</b><span>Space reserved for the coming Upkeep rules.</span></div>
          <span class="ps-h2">Wounds</span>
          <div class="ps-g2 wide">
            {{#each pc.wounds}}
            <div class="ps-uw {{key}}"><div class="ps-uwh"><b>{{label}} {{count}}</b><span class="ps-mut">Rest: {{check}} Check</span></div>
              {{#each named}}<button type="button" class="ps-uwchip" data-effect-id="{{id}}" data-action="openEffect" data-tooltip="Open the effect">{{name}}</button>{{else}}<span class="ps-mut">none named</span>{{/each}}
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      {{#if pc.npc}}
      <div class="tab" data-tab="builder">
        {{#with pc.builder}}
        <div class="ps-stack nbld">
          <div class="nb-top">
            <div class="ps-roleseg" role="group" aria-label="Role">{{#each roles}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setRole" data-role="{{key}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div>
            {{#if escAny}}<label class="ps-esctog"><input type="checkbox" name="system.useEscalation" {{#if escOn}}checked{{/if}} data-tooltip="Elite Escalation: on for an Elite (the Bestiary)"> Escalation</label>{{/if}}
            {{#if escOn}}<label class="ps-esctog"><input type="checkbox" name="system.eliteLadder" {{#if ladderOn}}checked{{/if}} data-tooltip="On: the Bestiary's ladder works by itself (1: 1 Boon on its first attack each round; 2: its Round Special Actions twice a round; 3: its Encounter Special Actions a second time). Off: its entry says otherwise: give it Features with those settings."> Default ladder</label>{{/if}}
            <span class="ps-right"></span>
            <label class="nb-stat"><span>Level</span><input type="number" min="0" name="system.level" value="{{level}}" aria-label="Level"></label>
            <div class="nb-stat dark" data-tooltip="Levels 1-4: Stage 1; 5-7: Stage 2; 8-10: Stage 3"><span>Stage</span><b>{{stage}}</b></div>
            <div class="nb-stat dark" data-tooltip="{{@root.npcCvTip}}"><span>CV</span><b>{{cv}}</b></div>
            <div class="nb-stat"><span>AP</span><b>{{ap}}</b></div>
          </div>
          <div class="nb-sum">{{#each summary}}<div><span>{{k}}</span><b>{{v}}</b></div>{{/each}}</div>
          {{!-- v0.0.308 (Lucas): the Tags first, above every table (some Tags will change the numbers) --}}
          <div class="ps-block nb-tagbar"><div class="ps-bh"><b>Tags</b><span class="ps-bsub">what the creature is (Profane, Undead...): Actions and rules can ask for them</span></div>
            <div class="nb-chips">{{#each @root.npcTags.have}}<span class="nb-chip">{{label}}<a data-action="removeTag" data-tag="{{key}}" aria-label="Remove {{label}}" data-tooltip="Remove">&times;</a></span>{{else}}<span class="ps-mut">No Tags.</span>{{/each}}
              {{#if @root.npcTags.add.length}}<select class="tagadd nb-add" aria-label="Add a Tag"><option value="">+ Tag</option>{{#each @root.npcTags.add}}<option value="{{key}}">{{label}}</option>{{/each}}</select>{{/if}}</div>
          </div>
          <div class="nb-cols">
            {{#each cols}}
            <div class="nb-col">
              {{#each this}}
              <div class="ps-block nb-blk" style="flex: {{grow}} 0 auto"><div class="ps-bh"><b>{{title}}</b></div>
                {{#each rows}}
                <div class="nb-row" style="--fc:{{color}}">
                  <div class="nb-rh"><b class="nb-nm">{{name}}</b><span class="nb-rt">{{ratingName}}</span><b class="nb-val">{{value}}</b></div>
                  <div class="nb-steps2">{{#each steps}}<button type="button" class="nb-step{{#if on}} on{{/if}}{{#if sel}} sel{{/if}}" data-action="{{../act}}" data-key="{{../key}}" data-rating="{{r}}" data-v="{{r}}" data-tooltip="{{tip}}" aria-label="{{../name}}: {{tip}}" aria-pressed="{{#if sel}}true{{else}}false{{/if}}"><i class="nb-pip"></i><span>{{v}}</span></button>{{/each}}</div>
                </div>
                {{/each}}
              </div>
              {{/each}}
            </div>
            {{/each}}
          </div>
          {{!-- v0.0.308 (Lucas): the old Stat block as rows like the others; Resist and Weak as chips --}}
          <div class="ps-block nb-frame"><div class="ps-bh"><b>Frame</b><span class="ps-bsub">for rules and Talents that ask; never its Defenses (those come from the ratings)</span></div>
            <div class="nb-frows">{{#each frame}}
              <div class="nb-row" style="--fc:{{color}}">
                <div class="nb-rh"><b class="nb-nm">{{name}}</b><span class="nb-rt">{{ratingName}}</span><b class="nb-val">{{value}}</b></div>
                <div class="nb-steps2">{{#each steps}}<button type="button" class="nb-step{{#if on}} on{{/if}}{{#if sel}} sel{{/if}}{{#if small}} small{{/if}}" data-action="setFrame" data-key="{{../key}}" data-v="{{r}}" data-tooltip="{{tip}}" aria-label="{{../name}}: {{tip}}" aria-pressed="{{#if sel}}true{{else}}false{{/if}}"><i class="nb-pip"></i><span>{{v}}</span></button>{{/each}}</div>
              </div>{{/each}}
            </div>
          </div>
          {{!-- v0.0.373 (STYLE-2, Lucas: version A): three lines of chips (the subtype's icon and color), the twelve subtypes to pick from, a stepper, Resist / Weak / Immune --}}
          <div class="ps-block nb-rw rwA"><div class="ps-bh"><b>Damage: Immune, Resist and Weak</b><button type="button" class="ps-dladd" data-action="dmgLineAdd" data-tooltip="Add a line in the pick window">+ Add</button><span class="ps-bsub">Resist lowers that type's damage by its number, Weak raises it; Immune ignores it</span></div>
            <div class="rw-lines">{{#each rw.lines}}<div class="rw-line"><span class="rw-k {{kind}}">{{label}}</span><span class="rw-v">{{#each chips}}<span class="rw-chip" style="{{style}}"><i class="{{icon}}" aria-hidden="true"></i><b>{{name}}</b>{{#if n}}<i class="rw-n">{{n}}</i>{{/if}}<a data-action="removeDmgMod" data-kind="{{kind}}" data-sub="{{sub}}" aria-label="Remove {{../label}} {{name}}" data-tooltip="Remove">&times;</a></span>{{else}}<span class="ps-mut">&mdash;</span>{{/each}}</span></div>{{/each}}</div>
            <div class="rw-add nb-rwadd"><span class="rw-k">Add</span>
              <div class="rw-pal">{{#each rw.pal}}<button type="button" class="rw-sub{{#if on}} on{{/if}}" style="{{style}}" data-action="pickRwSub" data-sub="{{sub}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}"><i class="{{icon}}" aria-hidden="true"></i><span>{{name}}</span></button>{{/each}}</div>
              <div class="rw-go"><span class="rw-num"><button type="button" data-action="rwStep" data-d="-1" aria-label="Less">&minus;</button><input type="number" class="nb-rwn" min="1" max="20" value="5" aria-label="Amount"><button type="button" data-action="rwStep" data-d="1" aria-label="More">+</button></span><button type="button" class="rw-btn resist" data-action="addDmgMod" data-kind="resist">Resist</button><button type="button" class="rw-btn weak" data-action="addDmgMod" data-kind="weak">Weak</button><button type="button" class="rw-btn immune" data-action="addDmgMod" data-kind="immune" data-tooltip="Immune takes no number">Immune</button></div>
            </div>
          </div>
          <div class="ps-block nb-atkblk{{#if vsWd}} nb-vswd{{/if}}"><div class="ps-bh"><b>Attack damage</b><span class="ps-bsub">Tier 2 / Tier 3 average, and the dice to write</span><span class="nb-vsw">{{#each vsToggle}}<button type="button" class="nb-vsb vsk-{{key}}{{#if on}} on{{/if}}" data-action="setNbVs" data-vs="{{key}}" data-tooltip="{{sub}}">{{label}}</button>{{/each}}</span></div>
            <p class="nb-how">Find the row of the Action's <b>AP</b>, then the column of <b>how hard it hits</b> (<b>Medium</b> is normal for a {{roleLabel}}). Each cell is the average damage on <b>Tier 2 / Tier 3</b>, and below it dice that give it with this creature's {{modLabel}}: write those on the Action.</p>
            {{!-- v0.0.309 (Lucas): the sheet's own look (tiles with the rating's color, like the pips), not a table --}}
            <div class="nb-dmg" style="--cols:{{heads.length}}">
              <div class="nb-dh"><span class="nb-dl">AP</span>{{#each heads}}<span class="nb-dhc{{#if med}} med{{/if}}" style="--rc:{{color}}">{{label}}</span>{{/each}}</div>
              {{#each attacks}}<div class="nb-dr"><div class="nb-dl"><b>{{label}}</b><small>{{sub}}</small></div>{{#each cells}}<div class="nb-dc{{#if med}} med{{/if}}" style="--rc:{{color}}" data-tooltip="{{tip}}"><b>{{v}}</b><small>{{dice}}</small></div>{{/each}}</div>{{/each}}
            </div>
            <ul class="nb-rules"><li><b>Vs. WD:</b> the same table; the dice use the Power Modifier ({{powerMod}}) instead, to [R] Resolve unless the Action writes [V] (the switch above shows them).</li><li><b>Conditions</b> cost damage: a Mild one takes the column 1 step to the left, Moderate 2, Severe 3.</li><li><b>Area Save Actions:</b> about half the damage, to each creature in the area (DC 11 + the Modifier).</li><li><b>Reactions:</b> a Trigger deals one column more than an Action of the same AP; an Interrupt the same.</li></ul>
          </div>
        </div>
        {{/with}}
      </div>

      <div class="tab" data-tab="loot">
        <div class="ps-stack">
          <span class="ps-mut">An NPC's items are flavor and loot: they never change its Health, Defenses or damage.</span>
          <div class="ps-block"><div class="nb-lh"><span>Item</span><span>Qty</span><span></span></div>
            <div class="olist" data-order-flag="itemOrder">
            {{#each pc.loot}}<div class="nb-loot lrow" data-item-id="{{id}}"><span><a data-action="openItem" class="ps-nm">{{name}}</a> <small class="ps-mut">{{note}}</small></span><span>{{qty}}</span><button type="button" class="ps-btn2" data-action="giveLoot" data-tooltip="Move {{name}} to a PC">Give to a PC</button></div>
            {{else}}<div class="nb-loot none">No items.</div>{{/each}}
            </div>
          </div>
          <div class="ps-drop">Drag items here</div>
        </div>
      </div>
      {{/if}}

      <div class="tab" data-tab="notes">
        <div class="ps-stack notes">
          <span class="ps-h2">Appearance</span>
          <div class="nbox">{{formInput notesFields.appearance enriched=notesEnriched.appearance value=system.appearance name="system.appearance" toggled=true}}</div>
          <span class="ps-h2">Background</span>
          <div class="nbox">{{formInput notesFields.background enriched=notesEnriched.background value=system.background name="system.background" toggled=true}}</div>
          <span class="ps-h2">Notes</span>
          <div class="nbox">{{formInput notesFields.notes enriched=notesEnriched.notes value=system.notes name="system.notes" toggled=true}}</div>
          {{#if isGM}}
          <span class="ps-h2">GM notes <small class="ps-mut"><i class="fa-solid fa-eye-slash"></i> only the GM sees them</small></span>
          <div class="nbox gm">{{formInput notesFields.gmNotes enriched=notesEnriched.gmNotes value=system.gmNotes name="system.gmNotes" toggled=true}}</div>
          {{/if}}
        </div>
      </div>
      </div>
    </section>
  </div>
</div>
