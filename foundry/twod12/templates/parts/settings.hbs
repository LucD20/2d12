{{!-- The settings of an Effect, or of a Feature's or Talent's passive: one per line, written as sentences (fxdetails.mjs). --}}
      {{#each settingsList}}
      <details class="setting fxd-set" data-i="{{i}}" {{#if open}}open{{/if}}>
        <summary class="shead"><span class="fxd-k">{{label}}</span><span class="fxd-sum">{{{sentence}}}</span><button type="button" data-action="removeSetting" data-index="{{i}}" aria-label="Remove setting">&times;</button></summary>
        {{#if ../isPassiveHost}}<div class="fxd-s">It works <select class="fxd-f" data-sfield="{{i}}" data-field="minEscalation">{{selectOptions ../escChoices selected=minEscalation}}</select>.</div>{{/if}}
        {{#if isBoonBane}}
        <div class="fxd-s">Give <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="boons" value="{{boons}}"> {{boonWord}} and <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="banes" value="{{banes}}"> {{baneWord}} (<select class="fxd-f" data-sfield="{{i}}" data-field="bbName">{{selectOptions bbChoices selected=bbName}}</select>) to rolls made <select class="fxd-f" data-sfield="{{i}}" data-field="against" data-bool>{{selectOptions ../whoChoices selected=againstVal}}</select></div>
        {{> "systems/twod12/templates/parts/preds.hbs"}}
        {{#if showByValue}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="byValue" {{#if byValue}}checked{{/if}}> Multiply by the condition's value (Vulnerable 2: 2 boons)</label>{{/if}}
        {{#if showOnce}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="oncePerRound" {{#if oncePerRound}}checked{{/if}}> Only the first matching Action each round</label>{{/if}}
        {{#if showMarked}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="vsMarked" {{#if vsMarked}}checked{{/if}}> Only against the creature it marked</label>{{/if}}
        {{#unless against}}<div class="fxd-s">It counts <select class="fxd-f" data-sfield="{{i}}" data-field="vsOrigin">{{selectOptions vsOriginChoices selected=vsOrigin}}</select>; only on rolls with
          {{#each attrs}}<label class="fxd-inl"><input type="checkbox" data-sset="{{../i}}" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}} (none ticked: any).</div>{{/unless}}
        <p class="fxd-help">Only rolls whose traits match get it; no traits = every roll. "Against this creature" is for rolls others make against it (Prone). Each Boon is +1 and each Bane −1; they cancel. A name (Field, Pressure, Support) caps that name at 2 Boons and 2 Banes on a roll; the book writes the name ("1 Pressure Bane"). Empowered and Enfeebled are their own setting. "Only the first matching Action each round": once per turn-cycle (from the start of the creature's turn to the start of its next one; against this creature, its own turn-cycle). "Only against the creature it marked": the creature an Action with "Marks the target" marked (Mark Quarry).</p>
        {{/if}}
        {{#if isAura}}
        <div class="fxd-s">An Aura <input type="number" min="1" class="fxd-f n" data-sfield="{{i}}" data-field="auraSize" value="{{auraSize}}"> around the creature. It affects <select class="fxd-f" data-sfield="{{i}}" data-field="auraWho">{{selectOptions auraWhoChoices selected=auraWho}}</select> <label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="auraSelf" {{#if auraSelf}}checked{{/if}}> and the creature itself</label></div>
        <div class="fxd-s">On the map: outline <input type="color" class="fxd-color" data-sfield="{{i}}" data-field="auraOutline" value="{{auraOutlineColor}}"> and squares <input type="color" class="fxd-color" data-sfield="{{i}}" data-field="auraFill" value="{{auraFillColor}}"></div>
        <div class="fx-drop" data-sfx="{{i}}">{{#if fxName}}Whoever is inside gains <b>{{fxName}}</b> (drop another Effect to replace it){{else}}Drop the Effect that whoever is inside gains{{/if}}</div>
        <p class="fxd-help">An Aura follows its creature: it reaches that many squares from every square the creature occupies. A creature gains the Effect as soon as it enters and loses it when it leaves, so the Effect should have no duration. The Aura itself ends when the Effect or passive that holds it does. On the map its outline shows during combat, and hovering the creature also tints the squares it covers; set the colors to tell several Auras apart.</p>
        {{/if}}
        {{#if isOnDamage}}
        <div class="fxd-s">When this creature deals <select class="fxd-f" data-sfield="{{i}}" data-field="trigSub">{{selectOptions subOpts selected=trigSub blank="any"}}</select> damage to a creature with the Tag <select class="fxd-f" data-sfield="{{i}}" data-field="trigTag">{{selectOptions tagChoices selected=trigTag blank="(any creature)"}}</select>:</div>
        <div class="fx-drop" data-sfx="{{i}}">{{#if fxName}}that creature gains <b>{{fxName}}</b> (drop another Effect to replace it){{else}}Drop the Effect that creature gains{{/if}}</div>
        <p class="fxd-help">It runs when the damage is applied to the target ("Profane Judgment": Holy damage to a Profane creature makes it Enfeebled 1). Tags are listed on a creature's sheet.</p>
        {{/if}}
        {{#if isDamageStep}}
        <div class="fxd-s">The damage of rolls made by this creature is Empowered <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="empowered" value="{{empowered}}"> and Enfeebled <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="enfeebled" value="{{enfeebled}}">.</div>
        {{> "systems/twod12/templates/parts/preds.hbs"}}
        {{#if false}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="oncePerRound" {{#if oncePerRound}}checked{{/if}}> Only the first matching Action each round</label>{{/if}}
        {{#if showMarked}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="vsMarked" {{#if vsMarked}}checked{{/if}}> Only against the creature it marked</label>{{/if}}
        <p class="fxd-help">Empowered N adds N to every damage die of the matching Actions, Enfeebled N takes N away (each die still deals at least 1). Only the highest of each counts (Stacking). Only rolls whose traits match; no traits = every roll.</p>
        {{/if}}
        {{#if isBonus}}
        <div class="fxd-s">The next matching action deals <input type="text" class="fxd-f w" data-sfield="{{i}}" data-field="dmg" value="{{dmg}}" placeholder="1d4"> extra <select class="fxd-f" data-sfield="{{i}}" data-field="dmgSub">{{selectOptions subOpts selected=dmgSub}}</select> damage to <select class="fxd-f" data-sfield="{{i}}" data-field="dmgPool">{{selectOptions poolOpts selected=dmgPool}}</select> on
          {{#each tierBoxes}}<label class="fxd-inl"><input type="checkbox" data-sset="{{../i}}" data-field="tiers" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
        {{> "systems/twod12/templates/parts/preds.hbs"}}
        <div class="fxd-s">The card adds <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="text" value="{{text}}" placeholder="Hindered (EoT)"></div>
        <div class="fx-drop" data-sfx="{{i}}">{{#if fxName}}It also applies <b>{{fxName}}</b> (drop another Effect to replace it){{else}}Drop an Effect here to apply it to the target on these tiers (optional){{/if}}</div>
        {{#if showOnce}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="oncePerRound" {{#if oncePerRound}}checked{{/if}}> Only the first matching Action each round</label>{{/if}}
        {{#if showMarked}}<label class="fxd-inl"><input type="checkbox" data-sfield="{{i}}" data-field="vsMarked" {{#if vsMarked}}checked{{/if}}> Only against the creature it marked</label>{{/if}}
        <p class="fxd-help">On an Effect, used up by the next action whose traits match; on a Feature's or Talent's passive, it works on every matching Action (or only the first each round, and then only on a Tier that deals damage). Write <code>[Mod]</code> for the Action's Modifier (Marked Quarry: [Mod] on T1). The tiers are the tier that action rolls; the card shows them like "(T2/T3)".</p>
        {{/if}}
        {{#if isIgnore}}
        <div class="fxd-s">Matching Actions don't take <select class="fxd-f" data-sfield="{{i}}" data-field="ignoreRule">{{selectOptions ignoreRules selected=ignoreRule}}</select>.</div>
        {{> "systems/twod12/templates/parts/preds.hbs"}}
        <p class="fxd-help">A Bane rule that this creature's matching Actions skip (Long Draw: one range Bane less with [Shot] Actions; Steady Nerves: the Engaged Banes; Sharpshooter: the Bane for a target Engaged with someone else). No traits = every Action.</p>
        {{/if}}
        {{#if isRally}}
        <div class="fxd-s">Each Rally Point heals <input type="text" class="fxd-f w" data-sfield="{{i}}" data-field="rallyBonus" value="{{rallyBonus}}" placeholder="power + 2"> more, for this creature and its allies within <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="rallyRange" value="{{rallyRange}}"> squares.</div>
        <p class="fxd-help">A number or a formula with <code>power</code>, <code>weapon</code>, <code>signature</code> (the Modifiers), <code>body</code>, <code>mind</code>, <code>appeal</code>, <code>instinct</code>, <code>level</code>, and <code>floor( )</code>, <code>ceil( )</code>, <code>min( , )</code>, <code>max( , )</code>. 0 squares: only this creature. Several such settings don't add up: the highest counts.</p>
        {{/if}}
        {{#if isCover}}
        <div class="fxd-s">Matching Actions ignore {{#each coverBoxes}}<label class="fxd-inl"><input type="checkbox" data-sset="{{../i}}" data-field="coverLevels" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}} cover.</div>
        {{> "systems/twod12/templates/parts/preds.hbs"}}
        <p class="fxd-help">The ticked levels give no Banes to the creature's matching Actions (Aim: Low cover for [Ranged] Actions; the roll dialog shows "Low cover ignored"). No traits = every Action. Total cover still blocks the Line of Effect.</p>
        {{/if}}
        {{#if isZone}}
        <div class="fxd-s">The placed area affects <select class="fxd-f" data-sfield="{{i}}" data-field="zoneWho">{{selectOptions zoneWhoChoices selected=zoneWho}}</select> inside it. At the start of each of their turns inside, they heal <input type="text" class="fxd-f w" data-sfield="{{i}}" data-field="zoneHeal" value="{{zoneHeal}}" placeholder="1d4 (empty: no heal)">.</div>
        <div class="fx-drop" data-sfx="{{i}}">{{#if fxName}}While inside they carry <b>{{fxName}}</b> (drop another Effect to replace it; clear it in the JSON to have none){{else}}Drop the Effect they carry while inside (optional){{/if}}</div>
        <p class="fxd-help">A Zone (v0.0.261, Consecrated Ground): the Action's Version applies this Effect, but it never lands on a creature: its Zone settings go on the area the Action keeps on the map (the Action's Area, kept, with its rounds; a Version's own rounds in the Versions editor). Enemies and allies are the sides of the creature who placed it. The carried Effect comes when a creature enters and goes when it leaves or the area ends, so it should have no duration. The heal is rolled in the chat and opens the creature's Heal window.</p>
        {{/if}}
        {{#if isTurnStart}}
        <div class="fx-drop" data-sfx="{{i}}">{{#if fxName}}At the start of each of its turns, the creature gains <b>{{fxName}}</b> (drop another Effect to replace it){{else}}Drop the Effect the creature gains at the start of each of its turns{{/if}}</div>
        <p class="fxd-help">Killer's Focus, Radiant Zeal: the Effect holds the Bonus Damage and ends after the Action that uses it ("Ends" on the Effect). A new copy replaces the old one each turn, only while this setting works (its "It works..."); it ends with the encounter. In play it is an ordinary applied effect: remove it, or untick its chip in the roll dialog.</p>
        {{/if}}
        {{#if isEscHook}}
        <div class="fxd-s">Once an encounter, when <select class="fxd-f" data-sfield="{{i}}" data-field="hookWhen">{{selectOptions hookWhens selected=hookWhen}}</select>, N = <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="hookRange" value="{{hookRange}}"> squares: the creature's Escalation rises by 1.</div>
        <p class="fxd-help">The class's Escalation hook (book, Chapter 2: Escalation): Kindled Wrath (an ally within 5 squares becomes Bloodied or goes Down), Thrill of the Kill (the Marked Quarry goes Down). Once an encounter; at Escalation 3 nothing happens and the once isn't used up. The system raises it and says so in the chat.</p>
        {{/if}}
        {{#if isMessage}}
        <div class="fxd-s"><select class="fxd-f" data-sfield="{{i}}" data-field="msgWhen">{{selectOptions msgWhens selected=msgWhen}}</select>, post to <select class="fxd-f" data-sfield="{{i}}" data-field="msgTo">{{selectOptions msgTos selected=msgTo}}</select>:</div>
        <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="text" value="{{text}}" placeholder="choose a creature to mark. Target it and use your marking Action.">
        <div class="fxd-s">and offer the Action <input type="text" class="fxd-f w" data-sfield="{{i}}" data-field="msgAction" value="{{msgAction}}" placeholder="Mark Quarry"> as a button, for <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="msgAp" value="{{msgAp}}"> AP.</div>
        <p class="fxd-help">The message starts with the creature's name; in the text, <code>{mark}</code> is the creature it marked (for "goes Down"). The button uses the creature's Action of that name (or <code>category:...</code>, <code>trait:...</code>) as a free use: it doesn't count toward its Frequency. No Action: no button. "Its owners" whispers it to the players who own the creature and the GM. "When the creature it marked goes Down": the mark of an Action with "Marks the target" (it ends then, and when an encounter starts).</p>
        {{/if}}
        {{#if isWeaponProp}}
        <div class="fxd-s">This creature's <select class="fxd-f" data-sfield="{{i}}" data-field="wpWhich">{{selectOptions wpWhiches selected=wpWhich}}</select> don't have the property <select class="fxd-f" data-sfield="{{i}}" data-field="wpProp">{{selectOptions wpProps selected=wpProp}}</select>.</div>
        <p class="fxd-help">Brawler: "Your Fists don't have the Non-threatening property": they threaten, so you can flank with them. Only the properties listed are read this way for now.</p>
        {{/if}}
        {{#if isMastery}}
        <div class="fxd-s">Choose one weapon with the property <select class="fxd-f" data-sfield="{{i}}" data-field="mstTrait">{{selectOptions mstTraits selected=mstTrait}}</select>: it starts at <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="mstValue" value="{{mstValue}}"> Mastery.</div>
        <p class="fxd-help">On a Feature or Talent of a character: the Mastery tab asks the player to choose the weapon (Sharpshooter: a Projectile weapon, 3 Mastery, so its Weapon Technique is unlocked). The Mastery never goes below that number when chosen; it can still grow.</p>
        {{/if}}
        {{#if isInline}}
        <div class="fxd-s">Has the Action <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="inlineAction" value="{{inlineAction}}" placeholder="Beacon's Step, or an Action's uuid"> while this lasts.</div>
        <p class="fxd-help">An inline Action (a card's own small Action: Beacon's Step). The Action is put on the creature when the effect is applied and taken away when it ends. A name is looked up on the creature, in the world, then in the compendium.</p>
        {{/if}}
        {{#if isGrant}}
        <div class="fxd-s">Can use <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="grantAction" value="{{grantAction}}" placeholder="Weapon Attack / category:Weapon Technique / trait:strike"> <input type="number" min="1" class="fxd-f n" data-sfield="{{i}}" data-field="grantCount" value="{{grantCount}}"> {{timesWord}} for <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="grantAp" value="{{grantAp}}"> AP, with <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="boons" value="{{boons}}"> {{boonWord}}.</div>
        <div class="fxd-s">The uses go <select class="fxd-f" data-sfield="{{i}}" data-field="grantDistinct" data-bool>{{selectOptions distinctChoices selected=grantDistinctStr}}</select>.</div>
        <div class="fxd-s">On <select class="fxd-f" data-sfield="{{i}}" data-field="grantOn">{{selectOptions grantOnChoices selected=grantOn}}</select>, <select class="fxd-f" data-sfield="{{i}}" data-field="grantDo">{{selectOptions grantDoChoices selected=grantDo}}</select> <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="grantText" value="{{grantText}}" placeholder="The target is Pushed 2."></div>
        <div class="fxd-s">And on <select class="fxd-f" data-sfield="{{i}}" data-field="grantOn2">{{selectOptions grantOnChoices selected=grantOn2}}</select>, <select class="fxd-f" data-sfield="{{i}}" data-field="grantDo2">{{selectOptions grantDoChoices selected=grantDo2}}</select> <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="grantText2" value="{{grantText2}}" placeholder="The target is also Pushed 2."></div>
        <p class="fxd-help">0 AP = free. The uses don't count toward the Action's Frequency or the 3 Strikes, and the Action is not faded on the sheet. Using the Action offers the granted use first. "On a result": with "the target's next damage is halved", the target's next damage card lights its Half button (Covering Shot, a Tier 3); with "the card says", the line goes on the granted use's card: the Critical row for a Critical, the Tier rows from that Tier up otherwise.</p>
        {{/if}}
        {{#if isDefense}}
        <div class="fxd-s">Give <input type="number" class="fxd-f n" data-sfield="{{i}}" data-field="defValue" data-signed value="{{defValue}}"> to <select class="fxd-f" data-sfield="{{i}}" data-field="defKind">{{selectOptions defKinds selected=defKind}}</select>.</div>
        <p class="fxd-help">"Every Defense" raises Armor, Ward and every Vs. Attribute. A negative number lowers it. Bonuses don't add up: the creature uses the highest bonus and the highest penalty for each Defense (from Features and effects). Armor and Ward are 11 + their value; Vs. an Attribute is 13 + half the Attribute.</p>
        {{/if}}
        {{#if isSpeed}}
        <div class="fxd-s"><select class="fxd-f" data-sfield="{{i}}" data-field="speedMode">{{selectOptions speedModes selected=speedMode}}</select> <input type="text" class="fxd-f w" data-sfield="{{i}}" data-field="speedFormula" value="{{speedFormula}}" placeholder="2  or  floor(speed/2)"></div>
        <p class="fxd-help">Replacements come first, then additions. <code>speed</code> is the creature's Speed; <code>floor( )</code>, <code>ceil( )</code>, <code>min( , )</code> and <code>max( , )</code> work. Hindered replaces it with <code>floor(speed/2)</code>. A Speed never goes below 0.</p>
        {{/if}}
        {{#if isLight}}
        <div class="fxd-s">The token sheds bright light out to <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="bright" value="{{bright}}"> and dim light out to <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="dim" value="{{dim}}"> squares, color <input type="text" class="fxd-f w" data-sfield="{{i}}" data-field="color" value="{{color}}" placeholder="#ffd27a">, intensity <input type="number" min="0" max="1" step="0.05" class="fxd-f n" data-sfield="{{i}}" data-field="lightAlpha" value="{{lightAlpha}}">, animation <select class="fxd-f" data-sfield="{{i}}" data-field="lightAnim">{{#each lightAnims}}<option value="{{key}}" {{#if on}}selected{{/if}}>{{label}}</option>{{/each}}</select> speed <input type="number" min="0" max="10" class="fxd-f n" data-sfield="{{i}}" data-field="lightSpeed" value="{{lightSpeed}}"> intensity <input type="number" min="0" max="10" class="fxd-f n" data-sfield="{{i}}" data-field="lightIntensity" value="{{lightIntensity}}">.</div>
        {{/if}}
        {{#if isBleed}}
        <div class="fxd-s">At the end of each of its turns, the creature takes <input type="text" class="fxd-f" data-sfield="{{i}}" data-field="dmg" value="{{dmg}}" placeholder="1d6"> damage to <select class="fxd-f" data-sfield="{{i}}" data-field="dmgPool">{{selectOptions poolOpts selected=dmgPool}}</select>, type <select class="fxd-f" data-sfield="{{i}}" data-field="dmgSub">{{selectOptions subOpts selected=dmgSub}}</select>. Its Save:
          {{#each attrs}}<label class="fxd-inl"><input type="checkbox" data-sset="{{../i}}" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}} against DC <input type="number" min="0" class="fxd-f n" data-sfield="{{i}}" data-field="bleedDc" value="{{bleedDc}}">.</div>
        <p class="fxd-help">Lingering (book, Chapter 8): the damage card is posted at the end of each of the creature's turns, targeting it. Pool "None": Vigor for Body / Instinct, Resolve for Mind / Appeal. A card's chip can set its own dice, pool, type, Attributes and DC (<code>@Condition[bleed|dmg:1d6|pool:R|sub:Ho|attrs:mi/ap]</code>).</p>
        {{/if}}
        {{#if isResist}}
        {{!-- v0.0.320 (pack AU part 2; book, Chapter 1 Resist, Weak and Immune) --}}
        <div class="fxd-s">The creature has <select class="fxd-f" data-sfield="{{i}}" data-field="rwKind">{{selectOptions rwKinds selected=rwKind}}</select>{{#if rwNum}} <input type="number" min="1" class="fxd-f n" data-sfield="{{i}}" data-field="rwValue" value="{{rwValue}}">{{/if}} <select class="fxd-f" data-sfield="{{i}}" data-field="dmgSub">{{selectOptions subOpts selected=dmgSub}}</select>.</div>
        <p class="fxd-help">Book, Chapter 1: once per Action or effect, on all its damage of that subtype, Vigor and Resolve together. Resist N reduces it by N, Weak N adds N (the origin chooses the pool when both have that subtype), Immune makes it 0. Two of the same kind and subtype don't add up: the highest counts, with the creature's own line (the NPC Builder's chips) too. The damage message applies it.</p>
        {{/if}}
        {{#if isFreqMore}}
        <div class="fxd-s">While this works, <select class="fxd-f" data-sfield="{{i}}" data-field="fmWhich">{{selectOptions fmChoices selected=fmWhich}}</select>.</div>
        <p class="fxd-help">The Elite ladder (Bestiary, Elite Escalation): at 2 its Round Special Action twice a round, at 3 its Encounter Special Action back once. Special Actions are the creature's own Actions, not the Basic Actions. Put the Escalation it needs in "It works".</p>
        {{/if}}
        {{#if isNote}}
        <div class="fxd-s">Show the note <input type="text" class="fxd-f wide" data-sfield="{{i}}" data-field="title" value="{{title}}" placeholder="Title"> in rolls with
          {{#each attrs}}<label class="fxd-inl"><input type="checkbox" data-sset="{{../i}}" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
        <textarea data-sfield="{{i}}" data-field="text" rows="3">{{text}}</textarea>
        <p class="fxd-help">No attribute ticked = every roll.</p>
        {{/if}}
      </details>
      {{/each}}
