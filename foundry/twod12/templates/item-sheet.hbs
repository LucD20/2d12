<div class="twod12 sheet item{{#if styled}} sk{{/if}}">
  <header class="head">
    <img src="{{item.img}}" data-edit="img" data-action="editImage" width="48" height="48" alt="">
    {{#if fxHeadLine}}<div class="fr-namecol"><input class="name" type="text" name="name" value="{{item.name}}" placeholder="Name"><p class="fr-headline">{{{fxHeadLine}}}</p></div>
    {{else}}<input class="name" type="text" name="name" value="{{item.name}}" placeholder="Name">{{/if}}
  </header>
  <nav class="tabs">
    {{!-- v0.0.191: links, not buttons: a read-only sheet (a locked compendium) disables every button, and the Details tab could not be opened --}}
    <a class="tabbtn" role="tab" data-action="switchTab" data-tab-target="description">Description</a>
    <a class="tabbtn" role="tab" data-action="switchTab" data-tab-target="details">Details</a>
    {{#if frQ}}<a class="fr-q" role="button" tabindex="0" data-fr-q aria-pressed="false" data-tooltip="Show the help texts">?</a>{{/if}}
  </nav>

  <section class="tab" data-tab="description">
    {{#if rawCard}}<div class="rawwrap">{{{rawCard}}}</div>{{/if}}
    {{formInput fields.description enriched=enriched value=system.description name="system.description" toggled=true}}
  </section>

  <section class="tab{{#if helpable}}{{#unless sheetHelp}} help-off{{/unless}}{{/if}}" data-tab="details">
    {{#if helpable}}<label class="sheet-helptoggle" data-tooltip="Show or hide the grey explanations on Action and Talent sheets"><input type="checkbox" data-sheethelp {{#if sheetHelp}}checked{{/if}}> Show help</label>{{/if}}
    {{#if isSpecies}}
    <h3>Attribute Values</h3>
    <div class="grid4">
      {{#each attrValues}}<label>{{label}} <input type="number" name="system.attributes.{{key}}" value="{{value}}"></label>{{/each}}
    </div>
    <label class="inline"><input type="checkbox" name="system.pickTwo" {{#if system.pickTwo}}checked{{/if}}> Select 2 choices for +1</label>
    <div class="grid3">
      <label>Vigor bonus <input type="number" name="system.bodyMod" value="{{system.bodyMod}}"></label>
      <label>Resolve bonus <input type="number" name="system.mindMod" value="{{system.mindMod}}"></label>
      <label class="inline" data-tooltip="Human: +3 to one threshold and +2 to the other, the player chooses. Type the bigger bonus as the Vigor bonus."><input type="checkbox" name="system.pickHealth" {{#if system.pickHealth}}checked{{/if}}> The player chooses the side of the bigger bonus</label>
      <label>Speed <input type="number" min="0" name="system.speed" value="{{system.speed}}"></label>
      <label>Reach <input type="number" min="0" name="system.reach" value="{{system.reach}}"></label>
      <label>Size (SR) <input type="number" min="1" max="7" name="system.size" value="{{system.size}}"></label>
    </div>
    <div class="steadybtns" data-tooltip="Steadiness: reduces the value of Forced Movement and Reposition against this species. Normally 0.">
      <span class="steady-lab">Steadiness</span>
      {{#each steadinessChoices}}<button type="button" class="steady-btn{{#if on}} on{{/if}}" data-action="setSteadiness" data-v="{{v}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{v}}</button>{{/each}}
    </div>
    {{/if}}

    {{#if isClass}}
    {{!-- v0.0.374 (PACK STYLE-2, Lucas: "a complete redo", approved in foundry/mockups/rest-dark.html): the Action editor's grammar. A section per
          subject, a label and its control on a line, a choice of few as buttons side by side, a small number as a stepper; Health and the Modifiers
          as a table by Stage with the totals; no tips beside headings or fields (the ? in the tab bar shows the help); each list of the Repertoire
          and the Escalation a row like a Tier, in its Frequency's color. --}}
    <div class="fr-tab cls2">
    <section class="fr-sec"><h3>The class</h3><div class="fr-pgrid">
      <span class="fr-pl">Flavor</span><div class="fr-pc"><input type="text" class="fr-in wide" name="system.flavor" value="{{system.flavor}}" placeholder="Your god's strength flows through your weapon and your hands."></div>
      <span class="fr-pl">Category</span><div class="fr-pc"><input type="text" class="fr-in" name="system.category" value="{{system.category}}" placeholder="Class"> <span class="fr-m">shown as <b>{{item.name}}</b></span></div>
      <span class="fr-pl">Armor</span><div class="fr-pc"><span class="fr-seg w">{{#each cls.seg.armor}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setClassField" data-field="{{../cls.seg.armorField}}" data-value="{{k}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{l}}</button>{{/each}}</span></div>
      <span class="fr-pl">Rally</span><div class="fr-pc"><span class="fr-step"><button type="button" data-action="stepClassField" data-field="system.rallyMod" data-d="-1" data-min="-5" data-max="20" aria-label="Less">&minus;</button><span class="v">{{system.rallyMod}}</span><button type="button" data-action="stepClassField" data-field="system.rallyMod" data-d="1" data-min="-5" data-max="20" aria-label="More">+</button></span></div>
      <span class="fr-pl">Speed</span><div class="fr-pc"><span class="fr-step"><button type="button" data-action="stepClassField" data-field="system.speedMod" data-d="-1" data-min="-5" data-max="5" aria-label="Less">&minus;</button><span class="v">{{cls.speedTxt}}</span><button type="button" data-action="stepClassField" data-field="system.speedMod" data-d="1" data-min="-5" data-max="5" aria-label="More">+</button></span></div>
    </div></section>
    <section class="fr-sec"><h3>Health</h3>
      <p class="fr-help">The class gives a high and a low Health value; the player puts the high one on Vigor or Resolve. Each grows by its step at Stages 1, 2 and 3 (Chapter 4).</p>
      <table class="cls-st"><thead><tr><th></th><th>Stage 0 <small>levels 1-3</small></th><th>Stage 1 <small>levels 4-7</small></th><th>Stage 2 <small>levels 8-11</small></th><th>Stage 3 <small>levels 12-15</small></th></tr></thead><tbody>
        <tr><th>High</th><td><input type="number" min="0" class="fr-in n" name="system.healthHigh" value="{{system.healthHigh}}"></td><td><span class="pl">+</span><input type="number" min="0" class="fr-in n" name="system.stepHigh1" value="{{system.stepHigh1}}"><span class="eq">= {{cls.hp.high1}}</span></td><td><span class="pl">+</span><input type="number" min="0" class="fr-in n" name="system.stepHigh2" value="{{system.stepHigh2}}"><span class="eq">= {{cls.hp.high2}}</span></td><td><span class="pl">+</span><input type="number" min="0" class="fr-in n" name="system.stepHigh3" value="{{system.stepHigh3}}"><span class="eq">= {{cls.hp.high3}}</span></td></tr>
        <tr><th>Low</th><td><input type="number" min="0" class="fr-in n" name="system.healthLow" value="{{system.healthLow}}"></td><td><span class="pl">+</span><input type="number" min="0" class="fr-in n" name="system.stepLow1" value="{{system.stepLow1}}"><span class="eq">= {{cls.hp.low1}}</span></td><td><span class="pl">+</span><input type="number" min="0" class="fr-in n" name="system.stepLow2" value="{{system.stepLow2}}"><span class="eq">= {{cls.hp.low2}}</span></td><td><span class="pl">+</span><input type="number" min="0" class="fr-in n" name="system.stepLow3" value="{{system.stepLow3}}"><span class="eq">= {{cls.hp.low3}}</span></td></tr>
      </tbody></table>
      {{#if system.bodyMult}}<p class="fr-help">Old Health multipliers (before pack R): Body &times;{{system.bodyMult}}, Mind &times;{{system.mindMult}}. They are used only while the high value above is 0.</p>{{/if}}
    </section>
    <section class="fr-sec"><h3>Modifiers</h3>
      <p class="fr-help">The class gives two Modifier values (+2 and +1 at level 1). "The player's choice": the player chooses which is the Weapon Modifier in the class window; otherwise the class fixes it. Stage 1 adds +1 to the one the player chooses, Stage 3 +1 to both, never above +4. The Attribute increases are set on level 1, in the Levels window.</p>
      <table class="cls-st"><thead><tr><th></th><th>Stage 0</th><th>Stage 1</th><th>Stage 2</th><th>Stage 3</th></tr></thead><tbody>
        <tr><th>High</th><td><span class="fr-step"><button type="button" data-action="stepClassField" data-field="system.modHigh" data-d="-1" data-min="0" data-max="4" aria-label="Less">&minus;</button><span class="v">{{cls.modHighTxt}}</span><button type="button" data-action="stepClassField" data-field="system.modHigh" data-d="1" data-min="0" data-max="4" aria-label="More">+</button></span></td><td rowspan="2" class="mid"><span class="eq">+1 to</span> <span class="fr-seg w">{{#each cls.seg.stage2}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setClassField" data-field="{{../cls.seg.stage2Field}}" data-value="{{k}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{l}}</button>{{/each}}</span></td><td rowspan="2" class="mid"><span class="eq">&mdash;</span></td><td rowspan="2" class="mid"><span class="eq">+1 to both</span></td></tr>
        <tr><th>Low</th><td><span class="fr-step"><button type="button" data-action="stepClassField" data-field="system.modLow" data-d="-1" data-min="0" data-max="4" aria-label="Less">&minus;</button><span class="v">{{cls.modLowTxt}}</span><button type="button" data-action="stepClassField" data-field="system.modLow" data-d="1" data-min="0" data-max="4" aria-label="More">+</button></span></td></tr>
      </tbody></table>
      <div class="fr-pgrid">
        <span class="fr-pl">High one is</span><div class="fr-pc"><span class="fr-seg w">{{#each cls.seg.order}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setClassField" data-field="{{../cls.seg.orderField}}" data-value="{{k}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{l}}</button>{{/each}}</span></div>
        <span class="fr-pl">Leads with</span><div class="fr-pc"><span class="fr-seg w">{{#each cls.seg.lead}}<button type="button" class="{{#if on}}on{{/if}}" data-action="setClassField" data-field="{{../cls.seg.leadField}}" data-value="{{k}}" aria-pressed="{{#if on}}true{{else}}false{{/if}}">{{l}}</button>{{/each}}</span></div>
        <span class="fr-pl">Attributes</span><div class="fr-pc"><b>{{#if cls.attrLine}}{{{cls.attrLineHtml}}}{{else}}none (set them on level 1){{/if}}</b></div>
      </div>
      {{#if cls.oldMods}}<p class="fr-help" style="display:block">This copy is from before the Modifiers were class values (both values are 0): it still uses the higher of {{cls.oldMods}}. Set the values above, or update it from the compendium.</p>{{/if}}
    </section>
    <section class="fr-sec"><h3 class="cls-h">Levels<button type="button" data-action="editLevels"><i class="fa-solid fa-layer-group"></i> Edit levels&hellip;</button></h3>
      <p class="fr-help">What the player gets at each level (Features, the Hallmark Action, Picks, Talents, Attribute choices) is set up in the Levels window. It opens wider than this sheet.</p>
      <div class="cls-levels">
        {{#each cls.levels}}<div><b>Level {{n}}</b><span>{{sections}} section{{#unless one}}s{{/unless}} &middot; {{choices}} choice{{#unless oneChoice}}s{{/unless}} to make</span></div>{{else}}<div><span>No levels yet.</span></div>{{/each}}
      </div>
    </section>
    <section class="fr-sec"><h3>Repertoire</h3>
      <p class="fr-help">Everything else the class offers, by Frequency. A "From the Repertoire" section in the Levels window chooses from here.</p>
      {{#each cls.rep}}<div class="cls-grp" style="--fq:{{fq}}"><span class="cls-gl">{{label}} &middot; {{list.length}}</span><span class="cls-chips">{{#each list}}<span class="cls-chip"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a><button type="button" data-action="removeLink" data-list="repertoire" data-index="{{index}}" aria-label="Remove {{name}}">&times;</button></span>{{/each}}</span></div>{{/each}}
      <div class="drop-zone" data-list="repertoire" data-accept="action,feature">Drop Actions and Features here</div>
    </section>
    <section class="fr-sec"><h3>Escalation</h3>
      <p class="fr-help">The class's Escalation abilities: the Passive and Active Escalation Picks choose from these. A Feature goes to the Passives, an Action to the Actives.</p>
      {{#each cls.esc}}<div class="cls-grp" style="--fq:{{fq}}"><span class="cls-gl">{{label}} &middot; {{list.length}}</span><span class="cls-chips">{{#each list}}<span class="cls-chip"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a>{{#if esc}} <i>Esc {{esc}}</i>{{/if}}<button type="button" data-action="removeLink" data-list="{{../key}}" data-index="{{index}}" aria-label="Remove {{name}}">&times;</button></span>{{/each}}{{#unless list.length}}<span class="cls-none">None yet</span>{{/unless}}</span></div>{{/each}}
      <div class="drop-zone" data-list="escalation" data-accept="action,feature">Drop Escalation abilities here</div>
    </section>
    </div>
    {{#unless cls.levels.length}}
    <div class="setbox oneline"><b>Attribute Increase Choices (a class without levels)</b>
      <span class="grp"><i>first</i>{{#each attrChecks.choiceA}}<label class="inline"><input type="checkbox" data-set="choiceA" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</span>
      <span class="grp"><i>second</i>{{#each attrChecks.choiceB}}<label class="inline"><input type="checkbox" data-set="choiceB" data-key="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</span></div>
    {{/unless}}
    {{#if featuresList.length}}
    <h3>Features (before the levels)</h3>
    <p class="hint">The old list of Features, each gained at its own level. A class with levels doesn't use it; it stays for classes made before v0.0.185.</p>
    <div class="drop-zone" data-list="features" data-accept="feature">Drop Features here</div>
    <ul class="items">
      {{#each featuresList}}
      <li draggable="true" data-uuid="{{uuid}}"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a>
        <span class="spacer"></span> <span class="ihint">{{cat}}{{#unless cat}}Level {{level}}{{/unless}}</span>
        <button type="button" data-action="removeLink" data-list="features" data-index="{{index}}">&times;</button></li>
      {{/each}}
    </ul>
    {{/if}}
    {{/if}}


    {{#if isTalent}}
    <div class="grid4">
      <label>Category <select name="system.group">{{selectOptions talentGroups selected=system.group}}</select></label>
      <label>Level <input type="number" min="0" name="system.level" value="{{system.level}}"></label>
      <label>Frequency <select name="system.frequency">{{selectOptions freqChoices selected=system.frequency}}</select></label>
      <label data-tooltip="A theme the Talent picker can filter by (Unarmed, Great Weapon, Marksman, Divine): usually the chain it belongs to">Theme <input type="text" name="system.theme" value="{{system.theme}}" placeholder="Unarmed"></label>
    </div>
    <label>Flavor <input type="text" name="system.flavor" value="{{system.flavor}}" placeholder="A small gift from the god you follow."></label>
    <label class="autosel" data-tooltip="How much Foundry does for this card, shown as a chip on it (Not implemented, Bronze, Silver, Gold)">Automation <select name="system.automation">{{selectOptions autoRanks selected=system.automation}}</select></label> <label class="autosel autonote" data-tooltip="What Foundry doesn't do yet for this card (shown on the diamond's tooltip). Mostly for Bronze and Silver">By hand <input type="text" name="system.automationNote" value="{{system.automationNote}}" placeholder="What the players do themselves"></label>
    <div class="prereqs">
      <div class="pq-line"><span class="pq-lead">Prerequisites:</span>
        {{#each prereqRows}}
        {{#unless @first}}<a class="pq-join" data-action="togglePrereqMode" data-tooltip="Click to switch: and (all of them) / or (any one of them)">{{../prereqJoin}}</a>{{/unless}}
        <span class="pq-chip pq-{{kind}}"><span class="pq-kind">{{kindLabel}}</span>
          {{#if isTalent}}<input type="text" data-pfield="{{i}}" data-field="name" value="{{name}}" placeholder="Brawler" list="twod12-talent-names">{{/if}}
          {{#if isLevel}}<input type="number" class="n" min="1" data-pfield="{{i}}" data-field="value" value="{{value}}">{{/if}}
          {{#if isTrait}}<select data-pfield="{{i}}" data-field="name">{{selectOptions ../traitChoices selected=name blank="(trait)"}}</select><span class="pq-kind">Action</span>{{/if}}
          {{#if isAttribute}}<select data-pfield="{{i}}" data-field="name">{{selectOptions ../attrChoices selected=name blank="(Attribute)"}}</select><input type="number" class="n" data-pfield="{{i}}" data-field="value" value="{{value}}">{{/if}}
          {{#if isOther}}<input type="text" class="wide" data-pfield="{{i}}" data-field="name" value="{{name}}" placeholder="Proficient with shields">{{/if}}
          <button type="button" data-action="removePrereq" data-index="{{i}}" aria-label="Remove">&times;</button></span>
        {{else}}<span class="pq-none">none: any character can take it</span>{{/each}}
        <select class="pq-add" data-prereqadd aria-label="Add a Prerequisite"><option value="">+ Add…</option>{{selectOptions prereqKinds}}</select>
      </div>
      {{#if system.requirements}}{{#unless prereqRows.length}}<p class="hint">Old text: <i>{{system.requirements}}</i> (add it as Prerequisites so the picker can check it).</p>{{/unless}}{{/if}}
      <datalist id="twod12-talent-names">{{#each talentNames}}<option value="{{this}}"></option>{{/each}}</datalist>
    </div>
    <p class="hint">Level is the character level needed to choose the Talent. Shown as {{categoryShown}}{{#if prereqShown}}; Prerequisites: {{prereqShown}}{{/if}}. The class window's Talent picker checks the Level and every Prerequisite but Other.</p>
    <label>Traits {{formInput fields.traits value=system.traits name="system.traits" options=traitPicker.options groups=traitPicker.groups}}</label>
    {{/if}}

    {{#if hasMods}}
    <h3>Modifies other Actions</h3>
    <p class="hint">Changes to other Actions while you have this Talent. <b>Action</b> is a name, <code>category:Weapon Technique</code> or <code>trait:strike</code>. Critical and Effects text are added to the Action's own.</p>
    {{#each talentMods}}
    <div class="setting">
      <div class="grid3">
        <label>Action <input type="text" name="system.modifiers.{{i}}.spec" value="{{spec}}" placeholder="category:Weapon Technique"></label>
        <label>When <select name="system.modifiers.{{i}}.when"><option value="always" {{#if always}}selected{{/if}}>Always</option><option value="outOfTurn" {{#if outOfTurn}}selected{{/if}}>When used out of your turn</option></select></label>
        <button type="button" data-action="removeTalentMod" data-index="{{i}}">&times; Remove</button>
      </div>
      <label>Critical <input type="text" name="system.modifiers.{{i}}.critical" value="{{critical}}" placeholder="You disrupt the triggering Action before it happens."></label>
      <label>Effects <input type="text" name="system.modifiers.{{i}}.effects" value="{{effects}}"></label>
    </div>
    {{/each}}
    <button type="button" data-action="addTalentMod"><i class="fa-solid fa-plus"></i> Add modifier</button>
    {{/if}}

    {{#if isTalent}}
    <h3>Choice</h3>
    <p class="hint">When this Talent is granted, a window asks which of these the character gets (Actions, Features or Talents). With no more options than the number to pick, they are all granted. They show under the Talent on the sheet.</p>
    <div class="grid3">
      <label>Label <input type="text" name="system.choiceLabel" value="{{system.choiceLabel}}" placeholder="Choose a blessing"></label>
      <label>Pick <input type="number" min="1" name="system.choiceCount" value="{{system.choiceCount}}"></label>
    </div>
    <div class="drop-zone" data-list="choiceOptions" data-accept="action,feature,talent">Drop the options here</div>
    <ul class="items">
      {{#each choiceList}}
      <li draggable="true" data-uuid="{{uuid}}"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a><span class="spacer"></span>
        <button type="button" data-action="removeLink" data-list="choiceOptions" data-index="{{index}}">&times;</button></li>
      {{/each}}
    </ul>
    <h3>Actions granted</h3>
    <button type="button" data-action="createLinkedAction"><i class="fa-solid fa-plus"></i> Generate Action</button>
    <div class="drop-zone" data-list="actions" data-accept="action">Drop Actions here</div>
    <ul class="items">
      {{#each actionsList}}
      <li draggable="true" data-uuid="{{uuid}}"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a><span class="spacer"></span>
        <button type="button" data-action="removeLink" data-list="actions" data-index="{{index}}">&times;</button></li>
      {{/each}}
    </ul>
    {{/if}}


    {{#if isFeature}}
    <div class="grid3">
      <label>Category <input type="text" name="system.category" value="{{system.category}}" placeholder="Paladin Feature"></label>
      <label>Level <input type="number" min="0" name="system.level" value="{{system.level}}"></label>
      <div class="ro"><span>Shown as</span><b>{{categoryShown}}</b></div>
    </div>
    <label>Flavor <input type="text" name="system.flavor" value="{{system.flavor}}" placeholder="Your bond with your god opens new paths."></label>
    <label class="autosel" data-tooltip="How much Foundry does for this card, shown as a chip on it (Not implemented, Bronze, Silver, Gold)">Automation <select name="system.automation">{{selectOptions autoRanks selected=system.automation}}</select></label> <label class="autosel autonote" data-tooltip="What Foundry doesn't do yet for this card (shown on the diamond's tooltip). Mostly for Bronze and Silver">By hand <input type="text" name="system.automationNote" value="{{system.automationNote}}" placeholder="What the players do themselves"></label>
    <label class="inline" data-tooltip="Shown in the Escalation section of the Features tab. When it works is each setting's own &quot;It works...&quot; below (Escalation 1, 2 or 3).">
      <input type="checkbox" name="system.escalationPassive" {{#if system.escalationPassive}}checked{{/if}}> Escalation Passive</label>
    <label>Talents granted <input type="number" min="0" name="system.talents" value="{{system.talents}}"></label>
    <p class="hint">Level is the class level at which the Feature is gained (0 counts as 1). Each Talent granted becomes a Talent slot on the character sheet ("Drop a Talent here (Feature name)").</p>
    <h3>Defenses</h3>
    <div class="opts"><button type="button" data-action="addDefense">Add defense</button><span class="ihint">+ to the DC of actions that roll Vs. an attribute against this creature</span></div>
    {{#each defensesList}}
    <div class="setting"><div class="grid3">
      <label>Raises <select data-dfield="{{i}}" data-field="attr">{{selectOptions ../defenseKindChoices selected=attr}}</select></label>
      <label>Bonus <input type="number" data-dfield="{{i}}" data-field="bonus" value="{{bonus}}"></label>
      <label>Only actions tagged <input type="text" data-dfield="{{i}}" data-field="tags" value="{{tags}}" placeholder="pushed, melee"></label>
    </div><button type="button" data-action="removeDefense" data-index="{{i}}" title="Remove">&times;</button></div>
    {{/each}}
    <h3>Actions granted</h3>
    <button type="button" data-action="createLinkedAction"><i class="fa-solid fa-plus"></i> Generate Action</button>
    <div class="drop-zone" data-list="actions" data-accept="action">Drop Actions here</div>
    <ul class="items">
      {{#each actionsList}}
      <li draggable="true" data-uuid="{{uuid}}"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a><span class="spacer"></span>
        <button type="button" data-action="removeLink" data-list="actions" data-index="{{index}}">&times;</button></li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if isAction}}
    {{!-- v0.0.355 (PACK ACTION-SHEET, Lucas's mockup A2): the card, when and where, a tab per Version (Tiers, the Effects applied, the steps after the damage),
         the rules it holds, Automation; on the left the order of events (actionsheet.mjs) --}}
    {{{actionTab}}}
    {{/if}}

    {{#if isArmor}}
    <div class="grid3">
      <label>Category <select name="system.category">{{selectOptions armorCategories selected=system.category}}</select></label>
      <label>Extra Armor (rare) <input type="number" name="system.bonus" value="{{system.bonus}}"></label>
      <label>Ward <input type="number" min="0" name="system.ward" value="{{system.ward}}"></label>
    </div>
    <label class="inline"><input type="checkbox" name="system.worn" {{#if system.worn}}checked{{/if}}> Worn</label>
    {{{dmgLinesHtml}}}
    <label>Properties <input type="text" name="system.properties" value="{{system.properties}}" placeholder="Resist Slash 1, Bulky (not automated yet)"></label>
    <p class="hint">The wearer's Armor is 11 + the category's value (Light 1, Medium 2, Heavy 3) + the extra; Ward adds to the wearer's Ward. Only one armor is worn at a time. Wearing armor beyond your class's Armor Training makes your Rolls Doomed and Actions against your Armor or Ward Favored.</p>
    {{/if}}

    {{#if isGear}}
    <div class="grid3">
      <label>Quantity <input type="number" min="0" name="system.quantity" value="{{system.quantity}}"></label>
      <label>Weight (each) <input type="number" min="0" step="any" name="system.weight" value="{{system.weight}}"></label>
      <label>Cost (each, coins) <input type="number" min="0" step="any" name="system.cost" value="{{system.cost}}"></label>
    </div>
    <p class="hint">Gear and loot: anything carried that is not a weapon or armor. The Items tab lists it with its quantity and adds up the weight.</p>
    {{/if}}

    {{#if isWeapon}}
    {{{dmgLinesHtml}}}
    <div class="opts"><button type="button" data-action="generateWeapon"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate Weapon</button><span class="ihint">one line, like <code>greatsword: two-handed, slash, 0/1d8/2d6</code></span></div>
    <label>Properties {{formInput fields.traits value=system.traits name="system.traits"}}</label>
    <div class="grid3">
      <label>Range <input type="text" name="system.range" value="{{system.range}}" placeholder="1   or   1/2   or   10/20/40"></label>
      {{#if weaponThrown}}<label>Thrown Range <input type="text" name="system.thrownRange" value="{{system.thrownRange}}" placeholder="4/8/12"></label>{{/if}}
      <label data-tooltip="Its Weapon Group (Chapter 15). You gain at most 1 Mastery per Weapon Group in each encounter. Empty: from its name (the book's weapon table).">Weapon Group <select name="system.weaponGroup">{{selectOptions weaponGroupChoices selected=system.weaponGroup}}</select></label>
      <label data-tooltip="The kind of weapon its Mastery counts for. Empty: its name. A +1 Greatsword with 'Greatsword' here shares the Greatsword's Mastery.">Mastery group <input type="text" name="system.masteryGroup" value="{{system.masteryGroup}}" placeholder="{{item.name}}"></label>
      {{#if system.reach}}<label>Old extra Reach <input type="number" min="0" name="system.reach" value="{{system.reach}}"></label>{{/if}}
    </div>
    <p class="hint">Every weapon has a Range, melee weapons included: normal / far (1 Bane) / maximum (2 Banes); one number has no far or maximum range (most melee weapons: 1). Reach above 1 adds to every number of a melee weapon's Range. Long: 1 bane against adjacent creatures, and it doesn't threaten them. Thrown: used in hand with its Range, thrown with its Thrown Range (a Ranged Action). A melee weapon without a Range uses 1 + its old extra Reach.</p>
    <label>Damage Subtype <select name="system.subtype">{{selectOptions subtypeChoices selected=system.subtype}}</select></label>
    {{#each weaponTiers}}
    <h3>{{label}} Damage</h3>
    <div class="grid4">
      <label>Damage to <select name="system.damage.{{key}}.pool">{{selectOptions ../poolChoices selected=d.pool}}</select></label>
      <label>Dice <input type="number" min="0" name="system.damage.{{key}}.count" value="{{d.count}}"></label>
      <label>Die <select name="system.damage.{{key}}.die">{{selectOptions ../dieChoices selected=d.die}}</select></label>
      <label>Modifier <input type="number" name="system.damage.{{key}}.mod" value="{{d.mod}}"></label>
    </div>
    {{/each}}
    <p class="hint">Die "None" gives flat damage (modifier only); 0 modifier and no die is 0 damage.</p>
    <h3>Weapon Techniques</h3>
    <div class="opts"><button type="button" data-action="createTechnique"><i class="fa-solid fa-plus"></i> Create Weapon Technique</button><span class="ihint">or drop an Action here</span></div>
    <div class="drop-zone" data-list="actions" data-accept="action">Drop Actions here</div>
    <ul class="items">
      {{#each actionsList}}
      <li draggable="true" data-uuid="{{uuid}}"><a data-action="openLinked" data-uuid="{{uuid}}">{{name}}</a><span class="spacer"></span>
        <button type="button" data-action="removeLink" data-list="actions" data-index="{{index}}">&times;</button></li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if isPassiveHost}}
    {{!-- v0.0.323 (PACK EFFECT-SHEET): the Passive is the same rules list as an Effect's (fxsheet.mjs), each rule with its own "Works" (Escalation) --}}
    <div class="fr-passive"><h3>Passive</h3><p class="hint">What the creature with this {{#if isFeature}}Feature{{else}}Talent{{/if}} has by itself. Each rule has its own "Works": always, or only while the Escalation is high enough.</p>{{{fxTab}}}</div>
    {{/if}}

    {{#if isEffect}}
    {{!-- v0.0.323 (PACK EFFECT-SHEET, Lucas's "Prototype C"): the hover card, the rules (list and pane), Ends, Automation, Advanced (fxsheet.mjs) --}}
    {{#if applied}}
    <div class="fr-applied">{{#if applied.valued}}<label>Value <input type="number" min="{{#if applied.exhausted}}0{{else}}1{{/if}}" class="fxd-f n" data-apvalue value="{{applied.value}}"></label>{{/if}}{{#if applied.isRounds}}<label><input type="number" min="0" class="fxd-f n" data-apleft value="{{applied.left}}"> {{applied.leftWord}} left</label>{{/if}}
      <a class="fxd-raw" data-action="openRaw">Foundry's effect window</a>
      <p class="fr-help">Changes apply to this creature only: the Effect it came from isn't changed. Applying the Effect again replaces this copy.</p></div>
    {{/if}}
    {{{fxTab}}}
    {{/if}}
  </section>
</div>
